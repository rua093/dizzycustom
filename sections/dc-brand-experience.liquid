{{ 'section-dc-brand-experience.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign story_image = section.settings.image
  if story_image == blank and product != blank
    assign story_image = product.featured_image
  endif
  assign mobile_story_image = section.settings.mobile_image | default: story_image

  assign button_link = section.settings.button_link
  if button_link == blank and product != blank
    assign main_section_prefix = section.id | split: '__' | first
    assign main_section_id = main_section_prefix | append: '__main'
    assign button_link = '#ProductInfo-' | append: main_section_id
  endif
-%}

<section class="dc-brand-experience color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="dc-brand-experience__story{% if section.settings.desktop_image_position == 'right' %} dc-brand-experience__story--image-right{% endif %}{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
    <div class="dc-brand-experience__media">
      {%- if story_image != blank -%}
        <picture>
          {%- if section.settings.mobile_image != blank -%}
            <source
              media="(max-width: 749px)"
              srcset="
                {{ mobile_story_image | image_url: width: 550 }} 550w,
                {{ mobile_story_image | image_url: width: 750 }} 750w,
                {{ mobile_story_image | image_url: width: 900 }} 900w
              "
              sizes="100vw"
            >
          {%- endif -%}
          {{
            story_image
            | image_url: width: 2400
            | image_tag:
              loading: 'lazy',
              widths: '750, 1100, 1500, 1800, 2172, 2400',
              sizes: '100vw',
              alt: story_image.alt
          }}
        </picture>
      {%- else -%}
        {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg dc-brand-experience__placeholder' }}
      {%- endif -%}
    </div>

    <div class="dc-brand-experience__content-layer page-width">
      <div class="dc-brand-experience__content">
        {%- if section.settings.eyebrow != blank -%}
          <p class="dc-brand-experience__eyebrow">{{ section.settings.eyebrow | escape }}</p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 class="dc-brand-experience__heading {{ section.settings.heading_size }}">{{ section.settings.heading }}</h2>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="dc-brand-experience__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {%- if section.settings.button_label != blank -%}
          <a
            class="button dc-brand-experience__button"
            {% if button_link == blank %}
              role="link" aria-disabled="true"
            {% else %}
              href="{{ button_link }}"
            {% endif %}
          >
            <span>{{ section.settings.button_label | escape }}</span>
            <span class="dc-brand-experience__button-icon" aria-hidden="true">{% render 'icon-arrow' %}</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- if section.blocks.size > 0 -%}
    <div class="dc-brand-experience__benefits page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.benefits_heading != blank -%}
          <h2 class="dc-brand-experience__benefits-heading h2">{{ section.settings.benefits_heading }}</h2>
        {%- endif -%}
        <ul class="dc-brand-experience__benefit-grid" role="list">
          {%- for block in section.blocks -%}
            <li
              class="dc-brand-experience__benefit{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
              {% if settings.animations_reveal_on_scroll %}
                data-cascade
                style="--animation-order: {{ forloop.index }};"
              {% endif %}
              {{ block.shopify_attributes }}
            >
              <span class="dc-brand-experience__benefit-icon" aria-hidden="true">
                {%- case block.settings.icon -%}
                  {%- when 'quality' -%}
                    {%- render 'icon-premium-metal-quality' -%}
                  {%- when 'customize' -%}
                    {%- render 'icon-fully-customizable' -%}
                  {%- when 'shield' -%}
                    {%- render 'icon-built-for-road' -%}
                  {%- when 'vehicle' -%}
                    {%- render 'icon-fits-more-than-cars' -%}
                {%- endcase -%}
              </span>
              {%- if block.settings.heading != blank -%}<h3 class="h3">{{ block.settings.heading }}</h3>{%- endif -%}
              {%- if block.settings.text != blank -%}<div class="rte">{{ block.settings.text }}</div>{%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
    </div>
  {%- endif -%}

  {%- if section.settings.show_feature_showcase -%}
    <div class="dc-brand-experience__showcase-wrap">
      <div class="dc-brand-experience__showcase page-width">
        <div class="dc-brand-experience__feature-row{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
          <article class="dc-brand-experience__feature-content">
            {%- if section.settings.craftsmanship_eyebrow != blank -%}
              <p class="dc-brand-experience__feature-eyebrow">{{ section.settings.craftsmanship_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="dc-brand-experience__feature-heading">
              {%- if section.settings.craftsmanship_accent != blank -%}
                <span>{{ section.settings.craftsmanship_accent | escape }}&nbsp;</span>
              {%- endif -%}
              {{ section.settings.craftsmanship_heading | escape }}
            </h2>
            {%- if section.settings.craftsmanship_text != blank -%}
              <div class="dc-brand-experience__feature-text rte">{{ section.settings.craftsmanship_text }}</div>
            {%- endif -%}
            {%- if section.settings.craftsmanship_label != blank -%}
              <p class="dc-brand-experience__feature-label">
                <span aria-hidden="true"></span>{{ section.settings.craftsmanship_label | escape }}
              </p>
            {%- endif -%}
          </article>

          <div class="dc-brand-experience__feature-media">
            {%- if section.settings.craftsmanship_image != blank -%}
              {{
                section.settings.craftsmanship_image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '550, 750, 1100, 1500, 1800',
                  sizes: '(min-width: 990px) 47vw, 100vw',
                  alt: section.settings.craftsmanship_image.alt
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if section.settings.craftsmanship_image_label != blank -%}
              <p class="dc-brand-experience__media-label"><span aria-hidden="true"></span>{{ section.settings.craftsmanship_image_label | escape }}</p>
            {%- endif -%}
          </div>
        </div>

        <div
          class="dc-brand-experience__feature-row dc-brand-experience__feature-row--reverse{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: 2;"
          {% endif %}
        >
          <div class="dc-brand-experience__feature-media">
            {%- if section.settings.installation_image != blank -%}
              {{
                section.settings.installation_image
                | image_url: width: 1800
                | image_tag:
                  loading: 'lazy',
                  widths: '550, 750, 1100, 1500, 1800',
                  sizes: '(min-width: 990px) 47vw, 100vw',
                  alt: section.settings.installation_image.alt
              }}
            {%- else -%}
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            {%- endif -%}
            {%- if section.settings.installation_image_label != blank -%}
              <p class="dc-brand-experience__media-label"><span aria-hidden="true"></span>{{ section.settings.installation_image_label | escape }}</p>
            {%- endif -%}
          </div>

          <article class="dc-brand-experience__feature-content">
            {%- if section.settings.installation_eyebrow != blank -%}
              <p class="dc-brand-experience__feature-eyebrow">{{ section.settings.installation_eyebrow | escape }}</p>
            {%- endif -%}
            <h2 class="dc-brand-experience__feature-heading">
              {%- if section.settings.installation_accent != blank -%}
                <span>{{ section.settings.installation_accent | escape }}&nbsp;</span>
              {%- endif -%}
              {{ section.settings.installation_heading | escape }}
            </h2>
            {%- if section.settings.installation_text != blank -%}
              <div class="dc-brand-experience__feature-text rte">{{ section.settings.installation_text }}</div>
            {%- endif -%}
            {%- if section.settings.installation_label != blank -%}
              <p class="dc-brand-experience__feature-label">
                <span aria-hidden="true"></span>{{ section.settings.installation_label | escape }}
              </p>
            {%- endif -%}
          </article>
        </div>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "DC brand experience",
  "tag": "section",
  "class": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Story image" },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile story image" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "MAKE YOUR RIDE" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "TRULY YOURS" },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        { "value": "h2", "label": "Small" },
        { "value": "h1", "label": "Medium" },
        { "value": "h0", "label": "Large" }
      ],
      "default": "h1",
      "label": "Heading size"
    },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>More than just an emblem. It’s a statement. Custom metal emblems that reflect your style, passion and personality.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "CUSTOMIZE YOURS TODAY" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    {
      "type": "select",
      "id": "desktop_image_position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left",
      "label": "Desktop image position"
    },
    { "type": "inline_richtext", "id": "benefits_heading", "label": "Benefits heading", "default": "Why Choose DizzyCustom" },
    { "type": "header", "content": "Feature showcase" },
    { "type": "checkbox", "id": "show_feature_showcase", "label": "Show feature showcase", "default": true },
    { "type": "image_picker", "id": "craftsmanship_image", "label": "Craftsmanship image" },
    { "type": "text", "id": "craftsmanship_image_label", "label": "Craftsmanship image label", "default": "CRAFTED BY HAND" },
    { "type": "text", "id": "craftsmanship_eyebrow", "label": "Craftsmanship eyebrow", "default": "CRAFTSMANSHIP" },
    { "type": "text", "id": "craftsmanship_accent", "label": "Craftsmanship blue heading", "default": "Precision" },
    { "type": "text", "id": "craftsmanship_heading", "label": "Craftsmanship heading", "default": "in Every Detail" },
    { "type": "richtext", "id": "craftsmanship_text", "label": "Craftsmanship text", "default": "<p>Every custom emblem is meticulously crafted by hand, ensuring a flawless finish that reflects your unique style and personality.</p>" },
    { "type": "text", "id": "craftsmanship_label", "label": "Craftsmanship footer label", "default": "HANDCRAFTED · BUILT TO STAND OUT" },
    { "type": "image_picker", "id": "installation_image", "label": "Installation image" },
    { "type": "text", "id": "installation_image_label", "label": "Installation image label", "default": "SIMPLE INSTALLATION" },
    { "type": "text", "id": "installation_eyebrow", "label": "Installation eyebrow", "default": "USER FRIENDLY" },
    { "type": "text", "id": "installation_accent", "label": "Installation blue heading", "default": "Effortless" },
    { "type": "text", "id": "installation_heading", "label": "Installation heading", "default": "Installation" },
    { "type": "richtext", "id": "installation_text", "label": "Installation text", "default": "<p>No tools, no hassle! Simply peel, stick, and enjoy a long-lasting, premium-quality emblem that stays in place for years.</p>" },
    { "type": "text", "id": "installation_label", "label": "Installation footer label", "default": "PEEL · STICK · DRIVE WITH CONFIDENCE" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "inverse" },
    { "type": "header", "content": "Section padding" },
    { "type": "range", "id": "padding_top", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding top", "default": 48 },
    { "type": "range", "id": "padding_bottom", "min": 0, "max": 100, "step": 4, "unit": "px", "label": "Padding bottom", "default": 48 }
  ],
  "blocks": [
    {
      "type": "benefit",
      "name": "Benefit",
      "limit": 4,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "options": [
            { "value": "quality", "label": "Quality" },
            { "value": "customize", "label": "Customize" },
            { "value": "shield", "label": "Shield" },
            { "value": "vehicle", "label": "Vehicle" }
          ],
          "default": "quality",
          "label": "Icon"
        },
        { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Benefit heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Share a clear reason customers can trust your product.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "DC brand experience",
      "blocks": [
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" },
        { "type": "benefit" }
      ]
    }
  ]
}
{% endschema %}
