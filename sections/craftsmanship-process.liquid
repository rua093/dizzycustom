{{ 'section-craftsmanship-process.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="CraftsmanshipProcess-{{ section.id }}"
  class="craftsmanship-process section-{{ section.id }}-padding"
  aria-labelledby="CraftsmanshipTitle-{{ section.id }}"
>
  <div class="page-width craftsmanship-process__container">
    {%- if section.settings.title != blank or section.settings.tagline != blank -%}
      <div class="craftsmanship-process__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.tagline != blank -%}
          <span class="craftsmanship-process__tagline">{{ section.settings.tagline }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="CraftsmanshipTitle-{{ section.id }}" class="craftsmanship-process__title">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="craftsmanship-process__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="craftsmanship-process__timeline" role="list">
      {%- for block in section.blocks -%}
        <li
          class="craftsmanship-step{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <div class="craftsmanship-step__badge-wrap">
            <span class="craftsmanship-step__badge" aria-hidden="true">
              {{ block.settings.step_number | default: forloop.index }}
            </span>
          </div>

          <div class="craftsmanship-step__card">
            {%- if block.settings.video != blank or block.settings.image != blank -%}
              {%- assign media_description = block.settings.media_description | default: block.settings.title | default: 'Craftsmanship step' -%}
              <div class="craftsmanship-step__media">
                {%- if block.settings.video != blank -%}
                  <video
                    class="craftsmanship-step__video"
                    data-craftsmanship-video
                    muted
                    loop
                    playsinline
                    preload="none"
                    aria-label="{{ media_description | escape }}"
                    {% if block.settings.video.preview_image != blank %}
                      poster="{{ block.settings.video.preview_image | image_url: width: 800 }}"
                    {% endif %}
                  >
                    {%- for source in block.settings.video.sources -%}
                      <source src="{{ source.url }}" type="{{ source.mime_type }}">
                    {%- endfor -%}
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: width: 800
                        | image_tag:
                          loading: 'lazy',
                          width: block.settings.image.width,
                          height: block.settings.image.height,
                          alt: media_description
                      }}
                    {%- endif -%}
                  </video>
                {%- else -%}
                  {{
                    block.settings.image
                    | image_url: width: 800
                    | image_tag:
                      loading: 'lazy',
                      width: block.settings.image.width,
                      height: block.settings.image.height,
                      alt: media_description
                  }}
                {%- endif -%}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank or block.settings.text != blank -%}
              <div class="craftsmanship-step__content">
                {%- if block.settings.title != blank -%}
                  <h3 class="craftsmanship-step__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="craftsmanship-step__text">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.blocks.size > 1 -%}
      <div class="craftsmanship-process__nav" aria-label="Craftsmanship timeline navigation">
        <div class="craftsmanship-process__dots" role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="craftsmanship-process__dot{% if forloop.first %} is-active{% endif %}"
              data-step-index="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Step {{ block.settings.step_number | default: forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      </div>

    {%- endif -%}
  </div>
</section>

<script>
  (() => {
    const section = document.getElementById('CraftsmanshipProcess-{{ section.id }}');
    if (!section) return;
    section._dcCraftsmanshipCleanup?.();

    const controller = new AbortController();
    const signal = controller.signal;
    const observers = [];
    const timeline = section.querySelector('.craftsmanship-process__timeline');
    const dots = Array.from(section.querySelectorAll('.craftsmanship-process__dot'));
    const steps = Array.from(section.querySelectorAll('.craftsmanship-step'));
    const videos = Array.from(section.querySelectorAll('[data-craftsmanship-video]'));
    const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

    const cleanup = () => {
      observers.forEach((observer) => observer.disconnect());
      videos.forEach((video) => video.pause());
      controller.abort();
      section._dcCraftsmanshipCleanup = null;
    };
    section._dcCraftsmanshipCleanup = cleanup;

    if (timeline && dots.length > 1 && steps.length > 1) {
      let activeIndex = 0;
      const updateActive = (index) => {
        if (index < 0 || index >= dots.length) return;
        activeIndex = index;
        dots.forEach((dot, dotIndex) => {
          const isActive = dotIndex === activeIndex;
          dot.classList.toggle('is-active', isActive);
          dot.setAttribute('aria-selected', String(isActive));
        });
      };

      dots.forEach((dot, index) => {
        dot.addEventListener('click', () => {
          const step = steps[index];
          if (!step) return;
          const paddingLeft = parseFloat(window.getComputedStyle(timeline).paddingLeft) || 16;
          timeline.scrollTo({
            left: step.offsetLeft - timeline.offsetLeft - paddingLeft,
            behavior: reducedMotion.matches ? 'auto' : 'smooth'
          });
          updateActive(index);
        }, { signal });
      });

      if ('IntersectionObserver' in window) {
        const stepObserver = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) updateActive(steps.indexOf(entry.target));
          });
        }, { root: timeline, threshold: 0.55 });
        steps.forEach((step) => stepObserver.observe(step));
        observers.push(stepObserver);
      } else {
        timeline.addEventListener('scroll', () => {
          const itemWidth = steps[0].offsetWidth + (parseFloat(window.getComputedStyle(timeline).gap) || 18);
          updateActive(Math.round(timeline.scrollLeft / itemWidth));
        }, { passive: true, signal });
      }
    }

    const updateVideo = (video) => {
      if (reducedMotion.matches || video.dataset.inView !== 'true') {
        video.pause();
        return;
      }
      video.play().catch(() => {});
    };

    if (videos.length && 'IntersectionObserver' in window) {
      const videoObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          entry.target.dataset.inView = String(entry.isIntersecting);
          if (entry.isIntersecting) entry.target.preload = 'metadata';
          updateVideo(entry.target);
        });
      }, { rootMargin: '300px 0px', threshold: 0.05 });
      videos.forEach((video) => videoObserver.observe(video));
      observers.push(videoObserver);
    }

    reducedMotion.addEventListener('change', () => videos.forEach(updateVideo), { signal });
    document.addEventListener('shopify:section:unload', (event) => {
      if (event.target === section || event.target?.contains(section) || event.detail?.sectionId === '{{ section.id }}') cleanup();
    }, { signal });
  })();
</script>

{% schema %}
{
  "name": "Craftsmanship Process",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline / Sub-heading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "How Dizzy Custom Make Your Emblem?",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "default": "01",
          "label": "Step Number"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image / GIF"
        },
        {
          "type": "video",
          "id": "video",
          "label": "Step video (preferred)"
        },
        {
          "type": "text",
          "id": "media_description",
          "label": "Media description",
          "info": "Describe the process shown for screen-reader users."
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title (optional)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step Description (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "01",
            "title": "",
            "text": ""
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "02",
            "title": "",
            "text": ""
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "03",
            "title": "",
            "text": ""
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "04",
            "title": "",
            "text": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
