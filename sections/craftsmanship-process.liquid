{{ 'section-craftsmanship-process.css' | asset_url | stylesheet_tag }}

{%- style -%}
  .section-{{ section.id }}-padding {
    --section-padding-top: {{ section.settings.padding_top }}px;
    --section-padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

<section
  id="CraftsmanshipProcess-{{ section.id }}"
  class="craftsmanship-process section-{{ section.id }}-padding"
  aria-labelledby="CraftsmanshipTitle-{{ section.id }}"
>
  <div class="page-width craftsmanship-process__container">
    {%- if section.settings.title != blank or section.settings.tagline != blank -%}
      <div class="craftsmanship-process__header{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.tagline != blank -%}
          <span class="craftsmanship-process__tagline">{{ section.settings.tagline }}</span>
        {%- endif -%}
        {%- if section.settings.title != blank -%}
          <h2 id="CraftsmanshipTitle-{{ section.id }}" class="craftsmanship-process__title">
            {{ section.settings.title }}
          </h2>
        {%- endif -%}
        {%- if section.settings.description != blank -%}
          <div class="craftsmanship-process__description">
            {{ section.settings.description }}
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}

    <ol class="craftsmanship-process__timeline" role="list">
      {%- for block in section.blocks -%}
        <li
          class="craftsmanship-step{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
          {{ block.shopify_attributes }}
          {% if settings.animations_reveal_on_scroll %}
            data-cascade
            style="--animation-order: {{ forloop.index }};"
          {% endif %}
        >
          <div class="craftsmanship-step__badge-wrap">
            <span class="craftsmanship-step__badge" aria-hidden="true">
              {{ block.settings.step_number | default: forloop.index }}
            </span>
          </div>

          <div class="craftsmanship-step__card">
            {%- if block.settings.image != blank -%}
              <div class="craftsmanship-step__media">
                {{
                  block.settings.image
                  | image_url: width: 800
                  | image_tag:
                    loading: 'lazy',
                    width: block.settings.image.width,
                    height: block.settings.image.height,
                    alt: block.settings.title | default: 'Craftsmanship step'
                }}
              </div>
            {%- endif -%}

            {%- if block.settings.title != blank or block.settings.text != blank -%}
              <div class="craftsmanship-step__content">
                {%- if block.settings.title != blank -%}
                  <h3 class="craftsmanship-step__title">{{ block.settings.title }}</h3>
                {%- endif -%}
                {%- if block.settings.text != blank -%}
                  <div class="craftsmanship-step__text">
                    {{ block.settings.text }}
                  </div>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        </li>
      {%- endfor -%}
    </ol>

    {%- if section.blocks.size > 1 -%}
      <div class="craftsmanship-process__nav" aria-label="Craftsmanship timeline navigation">
        <div class="craftsmanship-process__dots" role="tablist">
          {%- for block in section.blocks -%}
            <button
              type="button"
              class="craftsmanship-process__dot{% if forloop.first %} is-active{% endif %}"
              data-step-index="{{ forloop.index0 }}"
              role="tab"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-label="Step {{ block.settings.step_number | default: forloop.index }}"
            ></button>
          {%- endfor -%}
        </div>
      </div>

      <script>
        (() => {
          const section = document.getElementById('CraftsmanshipProcess-{{ section.id }}');
          if (!section) return;
          const timeline = section.querySelector('.craftsmanship-process__timeline');
          const dots = section.querySelectorAll('.craftsmanship-process__dot');
          const steps = section.querySelectorAll('.craftsmanship-step');
          if (!timeline || !dots.length || !steps.length) return;

          let activeIndex = 0;
          const updateActive = (index) => {
            if (index === activeIndex || index < 0 || index >= dots.length) return;
            activeIndex = index;
            dots.forEach((dot, i) => {
              const isActive = i === index;
              dot.classList.toggle('is-active', isActive);
              dot.setAttribute('aria-selected', String(isActive));
            });
          };

          dots.forEach((dot, index) => {
            dot.addEventListener('click', () => {
              const step = steps[index];
              if (step) {
                const paddingLeft = parseFloat(window.getComputedStyle(timeline).paddingLeft) || 16;
                timeline.scrollTo({
                  left: step.offsetLeft - timeline.offsetLeft - paddingLeft,
                  behavior: 'smooth'
                });
                updateActive(index);
              }
            });
          });

          if ('IntersectionObserver' in window) {
            const observer = new IntersectionObserver((entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  const index = Array.from(steps).indexOf(entry.target);
                  if (index !== -1) updateActive(index);
                }
              });
            }, {
              root: timeline,
              threshold: 0.55
            });
            steps.forEach((step) => observer.observe(step));
          } else {
            timeline.addEventListener('scroll', () => {
              const scrollLeft = timeline.scrollLeft;
              const itemWidth = steps[0].offsetWidth + (parseFloat(window.getComputedStyle(timeline).gap) || 18);
              const index = Math.round(scrollLeft / itemWidth);
              updateActive(index);
            }, { passive: true });
          }
        })();
      </script>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Craftsmanship Process",
  "tag": "section",
  "class": "section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline / Sub-heading"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "How Dizzy Custom Make Your Emblem?",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 20,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Process Step",
      "settings": [
        {
          "type": "text",
          "id": "step_number",
          "default": "01",
          "label": "Step Number"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Step Image / GIF"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Step Title (optional)"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Step Description (optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Craftsmanship Process",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "step_number": "01",
            "title": "",
            "text": ""
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "02",
            "title": "",
            "text": ""
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "03",
            "title": "",
            "text": ""
          }
        },
        {
          "type": "step",
          "settings": {
            "step_number": "04",
            "title": "",
            "text": ""
          }
        }
      ]
    }
  ]
}
{% endschema %}
