{{ 'template-collection.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-search.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
  {{ 'component-facets.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'facets.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{% if section.settings.image_shape == 'blob' %}
  {{ 'mask-blobs.css' | asset_url | stylesheet_tag }}
{%- endif -%}

<script src="{{ 'main-search.js' | asset_url }}" defer="defer"></script>

<style>
  .template-search__hero {
    background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%);
    border-bottom: 0.1rem solid #e2e8f0;
    padding: 5.4rem 0 4.2rem;
  }

  .template-search__header {
    margin-bottom: 0;
  }

  .template-search__title {
    margin: 0 0 1.2rem;
    font-size: 2.8rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: #0f172a;
    line-height: 1.2;
    text-align: center;
  }

  .template-search__search {
    margin: 0 auto;
    max-width: 64rem;
    position: relative;
    z-index: 2;
  }

  .template-search__search .search {
    margin-top: 1.2rem;
  }

  .template-search__search .field {
    height: 5.2rem;
    min-height: 5.2rem;
    border: 0.15rem solid #cbd5e1;
    border-radius: 9999px;
    background: #ffffff;
    box-shadow: 0 0.4rem 1.6rem rgba(15, 23, 42, 0.05);
    overflow: visible;
    display: flex;
    align-items: center;
    padding: 0.4rem;
    transition: all 0.25s ease;
  }

  .template-search__search .field:hover {
    border-color: #94a3b8;
    box-shadow: 0 0.6rem 2rem rgba(15, 23, 42, 0.08);
  }

  .template-search__search .field:focus-within {
    border-color: #0065a7;
    box-shadow: 0 0 0 0.35rem rgba(0, 101, 167, 0.15), 0 0.6rem 2.4rem rgba(15, 23, 42, 0.08);
  }

  .template-search__search .field::before,
  .template-search__search .field::after {
    display: none;
  }

  .template-search__search predictive-search {
    position: relative;
    display: block;
  }

  .template-search__search .predictive-search--search-template {
    top: calc(100% + 0.8rem);
    left: 0;
    width: 100%;
    max-height: 36rem;
    border-radius: 1.4rem;
    border: 0.1rem solid #e2e8f0;
    box-shadow: 0 1.6rem 3.6rem rgba(15, 23, 42, 0.14), 0 0.2rem 0.6rem rgba(15, 23, 42, 0.04);
    background: #ffffff;
    overflow: hidden;
  }

  .template-search__search .search__input.field__input {
    height: 100%;
    min-height: 100%;
    padding: 0 11rem 0 2rem;
    border: 0;
    background: transparent !important;
    box-shadow: none !important;
    color: #0f172a;
    font-size: 1.55rem;
    font-weight: 500;
    outline: none;
  }

  .template-search__search .search__input.field__input:focus,
  .template-search__search .search__input.field__input:focus-visible {
    border: 0;
    box-shadow: none !important;
    outline: none;
  }

  .template-search__search .search__input.field__input::placeholder {
    color: #94a3b8;
    font-weight: 400;
  }

  .template-search__search .field__label {
    display: none;
  }

  .template-search__search .search__button,
  .template-search__search .reset__button {
    top: 50%;
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: center;
    border: 0;
    box-shadow: none;
  }

  .template-search__search .reset__button {
    right: 9.6rem;
    width: 3.4rem;
    height: 3.4rem;
    border-radius: 50%;
    color: #94a3b8;
    background: transparent !important;
    transition: all 0.2s ease;
  }

  .template-search__search .reset__button:hover {
    color: #0f172a;
    background: #f1f5f9 !important;
  }

  .template-search__search .reset__button .icon {
    width: 1.6rem;
    height: 1.6rem;
  }

  .template-search__search .search__button {
    right: 0.5rem;
    height: 4.2rem;
    padding: 0 2rem;
    width: auto;
    border-radius: 9999px;
    background: #0065a7 !important;
    color: #ffffff !important;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.02em;
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    box-shadow: 0 0.2rem 0.8rem rgba(0, 101, 167, 0.22);
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .template-search__search .search__button:hover,
  .template-search__search .search__button:focus-visible {
    background: #004d80 !important;
    box-shadow: 0 0.4rem 1.2rem rgba(0, 101, 167, 0.32);
    transform: translateY(-50%) scale(1.02);
  }

  .template-search__search .search__button::before,
  .template-search__search .search__button::after,
  .template-search__search .reset__button::before,
  .template-search__search .reset__button::after {
    display: none;
  }

  .template-search__search .search__button .icon {
    display: none;
  }

  .template-search__button-label {
    display: inline-block;
  }

  /* Empty State Modern Box */
  .template-search__empty-box {
    margin: 3.6rem auto 1rem;
    max-width: 62rem;
    padding: 3.6rem 2.8rem;
    background: #ffffff;
    border: 0.1rem solid #e2e8f0;
    border-radius: 1.8rem;
    box-shadow: 0 1rem 3rem rgba(15, 23, 42, 0.04), 0 0.2rem 0.6rem rgba(15, 23, 42, 0.02);
    text-align: center;
  }

  .template-search__empty-icon-wrapper {
    width: 6.8rem;
    height: 6.8rem;
    margin: 0 auto 1.8rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: #f0f7fc;
    color: #0065a7;
    border-radius: 50%;
  }

  .template-search__empty-icon {
    width: 3.2rem;
    height: 3.2rem;
  }

  .template-search__empty-heading {
    margin: 0 0 1rem;
    font-size: 2.2rem;
    font-weight: 700;
    color: #0f172a;
    line-height: 1.3;
  }

  .template-search__empty-term {
    color: #0065a7;
  }

  .template-search__empty-subtext {
    margin: 0 0 2.4rem;
    font-size: 1.5rem;
    color: #64748b;
    line-height: 1.6;
    max-width: 48rem;
    margin-left: auto;
    margin-right: auto;
  }

  .template-search__suggestions {
    margin-bottom: 2.8rem;
    padding-top: 2rem;
    border-top: 0.1rem solid #f1f5f9;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.2rem;
  }

  .template-search__suggestions-title {
    font-size: 1.25rem;
    font-weight: 600;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.06em;
  }

  .template-search__chips {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
  }

  .template-search__chip {
    display: inline-flex;
    align-items: center;
    padding: 0.6rem 1.4rem;
    font-size: 1.35rem;
    font-weight: 500;
    color: #0065a7;
    background: #f8fafc;
    border: 0.1rem solid #e2e8f0;
    border-radius: 9999px;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .template-search__chip:hover {
    background: #0065a7;
    color: #ffffff;
    border-color: #0065a7;
    transform: translateY(-0.1rem);
    box-shadow: 0 0.4rem 1.2rem rgba(0, 101, 167, 0.2);
  }

  .template-search__empty-ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.2rem;
  }

  .template-search__cta-primary,
  .template-search__cta-secondary {
    position: relative;
  }

  .template-search__cta-primary::before,
  .template-search__cta-primary::after,
  .template-search__cta-secondary::before,
  .template-search__cta-secondary::after {
    display: none !important;
    content: none !important;
  }

  .template-search__cta-primary {
    background: #0065a7 !important;
    color: #ffffff !important;
    border-radius: 9999px !important;
    padding: 1.2rem 2.6rem !important;
    font-size: 1.45rem !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    border: none !important;
    box-shadow: 0 0.4rem 1.4rem rgba(0, 101, 167, 0.25) !important;
    transition: all 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  .template-search__cta-primary:hover {
    background: #004d80 !important;
    transform: translateY(-0.1rem) !important;
    box-shadow: 0 0.6rem 1.8rem rgba(0, 101, 167, 0.35) !important;
  }

  .template-search__cta-secondary {
    background: #ffffff !important;
    color: #0f172a !important;
    border: 0.15rem solid #cbd5e1 !important;
    border-radius: 9999px !important;
    padding: 1.2rem 2.6rem !important;
    font-size: 1.45rem !important;
    font-weight: 600 !important;
    text-decoration: none !important;
    transition: all 0.2s ease !important;
    display: inline-flex !important;
    align-items: center !important;
  }

  .template-search__cta-secondary:hover {
    border-color: #0065a7 !important;
    color: #0065a7 !important;
    background: #f8fafc !important;
    transform: translateY(-0.1rem) !important;
  }

  .template-search--empty {
    padding-bottom: 6rem;
  }

  @media screen and (min-width: 750px) {
    .template-search__hero {
      padding: 6.4rem 0 5.4rem;
    }

    .template-search__title {
      font-size: 3.6rem;
    }
  }

  @media screen and (max-width: 749px) {
    .template-search__hero {
      padding: 3.6rem 0 3rem;
    }

    .template-search__title {
      font-size: 2.4rem;
    }

    .template-search__search .field {
      height: 4.8rem;
      min-height: 4.8rem;
    }

    .template-search__search .search__input.field__input {
      padding: 0 9.2rem 0 1.6rem;
      font-size: 1.45rem;
    }

    .template-search__search .search__button {
      height: 3.8rem;
      padding: 0 1.4rem;
      font-size: 1.3rem;
    }

    .template-search__search .reset__button {
      right: 7.4rem;
      width: 3rem;
      height: 3rem;
    }

    .template-search__empty-box {
      padding: 2.8rem 1.6rem;
      margin-top: 2.8rem;
    }

    .template-search__empty-heading {
      font-size: 1.85rem;
    }

    .template-search__empty-subtext {
      font-size: 1.4rem;
    }

    .template-search__empty-ctas {
      flex-direction: column;
      width: 100%;
    }

    .template-search__cta-primary,
    .template-search__cta-secondary {
      width: 100%;
      justify-content: center;
    }
  }
</style>

{%- liquid
  assign sort_by = search.sort_by | default: search.default_sort_by
  assign terms = search.terms | escape
  assign search_url = '?q=' | append: terms | append: '&type=product&options%5Bprefix%5D=last&sort_by=' | append: sort_by
  assign product_results = search.results | where: 'object_type', 'product'
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: 0;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: 0;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{% paginate search.results by 24 %}
  <div class="template-search{% unless search.performed and product_results.size > 0 %} template-search--empty{% endunless %} section-{{ section.id }}-padding">
    <div class="template-search__hero">
      <div class="template-search__header page-width{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
        <h1 class="template-search__title">
          {%- if search.performed -%}
            {{- 'templates.search.title' | t -}}
          {%- else -%}
            {{- 'general.search.search' | t -}}
          {%- endif -%}
        </h1>

        <div class="template-search__search">
          {%- if settings.predictive_search_enabled -%}
            <predictive-search data-loading-text="{{ 'accessibility.loading' | t }}">
          {%- endif -%}
          <main-search>
            <form action="{{ routes.search_url }}" method="get" role="search" class="search">
              <div class="field">
                <input
                  class="search__input field__input"
                  id="Search-In-Template"
                  type="search"
                  name="q"
                  value="{{ search.terms | escape }}"
                  placeholder="Search emblems, styles, models..."
                  {%- if settings.predictive_search_enabled -%}
                    role="combobox"
                    aria-expanded="false"
                    aria-owns="predictive-search-results"
                    aria-controls="predictive-search-results"
                    aria-haspopup="listbox"
                    aria-autocomplete="list"
                    autocorrect="off"
                    autocomplete="off"
                    autocapitalize="off"
                    spellcheck="false"
                  {%- endif -%}
                >
                <label class="field__label" for="Search-In-Template">{{ 'general.search.search' | t }}</label>
                <input name="options[prefix]" type="hidden" value="last">
                <input name="type" type="hidden" value="product">

                {%- if settings.predictive_search_enabled -%}
                  <div
                    id="predictive-search-results"
                    class="predictive-search predictive-search--search-template"
                    tabindex="-1"
                    data-predictive-search
                  >
                    {%- render 'loading-spinner', class: 'predictive-search__loading-state' -%}
                  </div>

                  <span class="predictive-search-status visually-hidden" role="status" aria-hidden="true"></span>
                {%- endif -%}

                <button
                  type="reset"
                  class="reset__button field__button{% if search.terms == blank %} hidden{% endif %}"
                  aria-label="{{ 'general.search.reset' | t }}"
                >
                  <svg class="icon icon-close" aria-hidden="true" focusable="false">
                    <use xlink:href="#icon-reset">
                  </svg>
                </button>
                <button type="submit" class="search__button field__button" aria-label="{{ 'general.search.search' | t }}">
                  <span class="template-search__button-label">Search</span>
                  <svg class="icon icon-search" aria-hidden="true" focusable="false">
                    <use xlink:href="#icon-search">
                  </svg>
                </button>
              </div>
            </form>
          </main-search>
          {%- if settings.predictive_search_enabled -%}
            </predictive-search>
          {%- endif -%}
        </div>

        {%- if search.performed -%}
          {%- unless section.settings.enable_filtering or section.settings.enable_sorting -%}
            {%- if product_results.size > 0 -%}
              <p class="template-search__results-summary center" role="status">
                {{ 'templates.search.results_with_count_and_term' | t: terms: search.terms, count: product_results.size }}
              </p>
            {%- endif -%}
          {%- endunless -%}
          {%- if product_results.size == 0 and search.filters == empty -%}
            <div class="template-search__empty-box">
              <div class="template-search__empty-icon-wrapper">
                <svg class="template-search__empty-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                  <circle cx="11" cy="11" r="8"></circle>
                  <line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                  <line x1="8" y1="11" x2="14" y2="11"></line>
                </svg>
              </div>
              <h2 class="template-search__empty-heading">
                No results found for “<span class="template-search__empty-term">{{ search.terms | escape }}</span>”
              </h2>
              <p class="template-search__empty-subtext">
                Check your spelling, try broader keywords, or explore our popular collections and custom emblem options below.
              </p>

              <div class="template-search__suggestions">
                <span class="template-search__suggestions-title">Popular searches</span>
                <div class="template-search__chips">
                  <a href="{{ routes.search_url }}?q=Custom&type=product" class="template-search__chip">Custom</a>
                  <a href="{{ routes.search_url }}?q=Emblem&type=product" class="template-search__chip">Emblem</a>
                  <a href="{{ routes.search_url }}?q=Edition&type=product" class="template-search__chip">Edition</a>
                  <a href="{{ routes.search_url }}?q=V8&type=product" class="template-search__chip">V8</a>
                  <a href="{{ routes.search_url }}?q=Turbo&type=product" class="template-search__chip">Turbo</a>
                  <a href="{{ routes.search_url }}?q=Metal&type=product" class="template-search__chip">Metal</a>
                </div>
              </div>

              <div class="template-search__empty-ctas">
                <a href="{{ routes.all_products_collection_url }}" class="button button--primary template-search__cta-primary">
                  Explore All Emblems
                </a>
                <a href="/pages/contact" class="button button--secondary template-search__cta-secondary">
                  Custom Emblem Request
                </a>
              </div>
            </div>
          {%- endif -%}
        {%- endif -%}
      </div>
    </div>
    {%- if search.performed -%}
      {%- if section.settings.enable_sorting
        and section.settings.filter_type == 'vertical'
        and search.filters != empty
      -%}
        <facet-filters-form class="facets facets-vertical-sort page-width small-hide no-js-hidden">
          <form class="facets-vertical-form" id="FacetSortForm">
            <div class="facet-filters sorting caption">
              <div class="facet-filters__field">
                <h2 class="facet-filters__label caption-large text-body">
                  <label for="SortBy">{{ 'products.facets.sort_by_label' | t }}</label>
                </h2>
                <div class="select">
                  {%- assign sort_by = search.sort_by | default: search.default_sort_by -%}
                  <select
                    name="sort_by"
                    class="facet-filters__sort select__select caption-large"
                    id="SortBy"
                    aria-describedby="a11y-refresh-page-message"
                  >
                    {%- for option in search.sort_options -%}
                      <option
                        value="{{ option.value | escape }}"
                        {% if option.value == sort_by %}
                          selected="selected"
                        {% endif %}
                      >
                        {{ option.name | escape }}
                      </option>
                    {%- endfor -%}
                  </select>
                  {% render 'icon-caret' %}
                </div>
              </div>
              <noscript>
                <button type="submit" class="facets__button-no-js button button--secondary">
                  {{ 'products.facets.sort_button' | t }}
                </button>
              </noscript>
            </div>

            <div class="product-count-vertical light" role="status">
              <h2 class="product-count__text text-body">
                <span id="ProductCountDesktop">
                  {%- if search.results_count -%}
                    {{ 'templates.search.results_with_count' | t: terms: search.terms, count: search.results_count }}
                  {%- elsif search.products_count == search.all_products_count -%}
                    {{ 'products.facets.product_count_simple' | t: count: search.products_count }}
                  {%- else -%}
                    {{
                      'products.facets.product_count'
                      | t: product_count: search.products_count, count: search.all_products_count
                    }}
                  {%- endif -%}
                </span>
              </h2>
              {%- render 'loading-spinner' -%}
            </div>
          </form>
        </facet-filters-form>
      {%- endif -%}
      <div
        {% if section.settings.filter_type == 'vertical' %}
          class="facets-vertical page-width"
        {% endif %}
      >
        {%- if search.filters != empty -%}
          {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
            <aside
              aria-labelledby="verticalTitle"
              class="facets-wrapper{% unless section.settings.enable_filtering %} facets-wrapper--no-filters{% endunless %}{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="main-search-filters"
              data-id="{{ section.id }}"
            >
              {% render 'facets',
                results: search,
                enable_filtering: section.settings.enable_filtering,
                enable_sorting: section.settings.enable_sorting,
                filter_type: section.settings.filter_type,
                paginate: paginate
              %}
            </aside>
          {%- endif -%}
        {%- endif -%}
        <div class="product-grid-container" id="ProductGridContainer">
          {%- if product_results.size == 0 and search.filters != empty -%}
            <div
              class="template-search__results collection collection--empty{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <div class="title-wrapper center">
                <h2 class="title title--primary">
                  {{ 'sections.collection_template.empty' | t -}}
                  <br>
                  {{
                    'sections.collection_template.use_fewer_filters_html'
                    | t: link: search_url, class: 'underlined-link link'
                  }}
                </h2>
              </div>
            </div>
          {%- else -%}
            <div
              class="template-search__results collection{% if section.settings.filter_type != 'vertical' %} page-width{% endif %}"
              id="product-grid"
              data-id="{{ section.id }}"
            >
              <div class="loading-overlay gradient"></div>
              <ul
                class="grid product-grid  grid--{{ section.settings.columns_mobile }}-col-tablet-down grid--{{ section.settings.columns_desktop }}-col-desktop"
                role="list"
              >
                {%- for item in product_results -%}
                  {% assign lazy_load = false %}
                  {%- if forloop.index > 2 -%}
                    {%- assign lazy_load = true -%}
                  {%- endif -%}

                  {%- if item.object_type == 'product' -%}
                    <li
                      class="grid__item{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
                      {% if settings.animations_reveal_on_scroll %}
                        data-cascade
                      {% endif %}
                    >
                      {% render 'card-product',
                        card_product: item,
                        media_aspect_ratio: section.settings.image_ratio,
                        image_shape: section.settings.image_shape,
                        show_secondary_image: section.settings.show_secondary_image,
                        show_vendor: section.settings.show_vendor,
                        show_rating: section.settings.show_rating,
                        lazy_load: lazy_load
                      %}
                    </li>
                  {%- endif -%}
                {%- endfor -%}
              </ul>
              {%- if paginate.pages > 1 -%}
                {% render 'pagination', paginate: paginate %}
              {%- endif -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    {%- endif -%}
  </div>
{% endpaginate %}
{% if section.settings.image_shape == 'arch' %}
  {% render 'mask-arch' %}
{%- endif -%}

{% schema %}
{
  "name": "t:sections.main-search.name",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "range",
      "id": "columns_desktop",
      "min": 1,
      "max": 5,
      "step": 1,
      "default": 4,
      "label": "t:sections.main-search.settings.columns_desktop.label"
    },
    {
      "type": "header",
      "content": "t:sections.main-search.settings.header__1.content"
    },
    {
      "type": "select",
