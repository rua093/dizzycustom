{%- liquid
  assign font_keys = 'bold,lightning,aggressive,script,electric,ice,oem' | split: ','
  assign font_labels = 'Bold,Slant,Edge,Flow,Strike,Frost,Classic' | split: ','
  assign badge_product = section.settings.product
  if badge_product == blank
    assign badge_product = settings.custom_emblem_product
  endif
  assign is_product_page = false
  if request.page_type == 'product'
    assign badge_product = product
    assign is_product_page = true
  endif
  assign initial_variant = badge_product.selected_or_first_available_variant
  assign default_variant = initial_variant
-%}
{{ 'dc-emblem-builder.css' | asset_url | stylesheet_tag }}
{%- for key in font_keys -%}
  {%- assign font_file = 'dc-badge-' | append: key | append: '.woff2' -%}
  <link rel="preload" href="{{ font_file | asset_url }}" as="font" type="font/woff2" crossorigin>
{%- endfor -%}
<script src="{{ 'dc-emblem-core.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'dc-emblem-builder.js' | asset_url }}" defer="defer"></script>

<section class="dc-builder-section color-{{ section.settings.color_scheme }} gradient" style="--dc-builder-space: {{ section.settings.padding }}px">
  <div class="page-width">
    {% if is_product_page %}
      <header class="dc-builder-heading{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"{% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>
        <h1>{{ product.title | escape }}</h1>
      </header>
    {% endif %}

    <dc-emblem-builder
      class="{% if settings.animations_reveal_on_scroll %}scroll-trigger animate--slide-in{% endif %}"
      data-product-page="{{ is_product_page }}"
      data-demo="{{ section.settings.demo }}"
      {% if settings.animations_reveal_on_scroll %}
        data-cascade
      {% endif %}
    >
      <script type="application/json" data-builder-config>
        {
          "productUrl": {{ badge_product.url | default: '' | json }},
          "defaultText": {{ section.settings.default_text | json }},
          "maxLength": {{ section.settings.max_length | json }},
          "price": {{ default_variant.price | money_with_currency | json }},
          "available": {{ default_variant.available | default: false | json }},
          "defaultVariantId": {{ default_variant.id | json }},
          "defaultSizeTitle": {{ default_variant.title | json }},
          "defaultSizeMax": {%- if default_variant.title contains '8 Letters' -%}8{%- elsif default_variant.title contains '12 Letters' -%}12{%- else -%}16{%- endif -%},
          "fonts": [
            {% for key in font_keys %}
              {% assign font_file = 'dc-badge-' | append: key | append: '.woff2' %}
              {"key": {{ key | json }}, "label": {{ font_labels[forloop.index0] | json }}, "url": {{ font_file | asset_url | json }}}{% unless forloop.last %},{% endunless %}
            {% endfor %}
          ]
        }
      </script>
      <div class="dc-builder-stage">
        <span class="dc-builder-live"><span></span> Live preview</span>
        <span class="dc-builder-stage-guide" id="BadgeHelp-{{ section.id }}">Letters, numbers, spaces and punctuation. Up to {{ section.settings.max_length }} characters.</span>
        <canvas data-preview width="1200" height="460" role="img" aria-label="Your custom two-layer badge preview"></canvas>
      </div>
      <form class="dc-builder-controls" action="{{ routes.cart_add_url }}" method="post">
        <fieldset class="dc-builder-fields" data-controls disabled>
          <div class="dc-builder-col dc-builder-col--text-font">
            <div class="dc-builder-text-group">
              <div class="dc-builder-label-row">
                <label for="BadgeText-{{ section.id }}" class="dc-builder-step-title"><span class="dc-builder-step-badge" aria-hidden="true">1</span>Your text</label>
                <span data-count>{{ section.settings.default_text.size | default: 0 }}/{{ section.settings.max_length }}</span>
              </div>
              <input class="dc-builder-input" id="BadgeText-{{ section.id }}" data-text name="properties[Custom Text]" type="text" value="{{ section.settings.default_text | escape }}" maxlength="{{ section.settings.max_length }}" placeholder="Type your text…" required autocomplete="off" spellcheck="false" aria-describedby="BadgeHelp-{{ section.id }} BadgeError-{{ section.id }}">
            </div>

            <fieldset class="dc-builder-group">
              <legend>Font</legend>
              <div class="dc-builder-fonts">
                {% for key in font_keys %}
                  <button type="button" class="dc-builder-font" data-font="{{ key }}" aria-pressed="{% if key == 'lightning' %}true{% else %}false{% endif %}" style="--badge-font: 'DC Badge {{ key }}'">{{ font_labels[forloop.index0] }}</button>
                {% endfor %}
              </div>
            </fieldset>
          </div>

          <div class="dc-builder-col dc-builder-col--colors">
            <fieldset class="dc-builder-group">
              <legend><span class="dc-builder-step-title"><span class="dc-builder-step-badge" aria-hidden="true">2</span>Colors</span></legend>
              <div class="dc-builder-palette">
                <div class="dc-builder-layer-count" role="group" aria-label="Number of emblem layers">
                  <button type="button" data-layer-count="1" aria-pressed="false">1 Layer</button>
                  <button type="button" data-layer-count="2" aria-pressed="true">2 Layers</button>
                </div>
                <div class="dc-builder-layers">
                  <button class="dc-builder-layer" type="button" data-layer="face" aria-pressed="true"><span class="dc-builder-chip" data-chip="face"></span><span><small><span class="dc-builder-layer-prefix">Front </span>Text</small><strong data-color-name="face">Mirror White</strong></span></button>
                  <button class="dc-builder-layer" type="button" data-layer="back" aria-pressed="false"><span class="dc-builder-chip" data-chip="back"></span><span><small><span class="dc-builder-layer-prefix">Base </span>Backing</small><strong data-color-name="back">Gloss Black</strong></span></button>
                </div>
                <div class="dc-builder-finishes" role="group" aria-label="Material category">
                  <button type="button" data-finish="solid" aria-pressed="false">Solid</button>
                  <button type="button" data-finish="mirror" aria-pressed="true">Mirror</button>
                  <button type="button" data-finish="flake" aria-pressed="false">Metal flake</button>
                </div>
                <div class="dc-builder-swatches" data-swatches role="group" aria-label="Text color">
                  <button type="button" class="dc-builder-swatch" data-swatch="mirror_white" aria-label="Mirror White" title="Mirror White" aria-pressed="true">
                    <span style="background: linear-gradient(135deg, #f7f7f7 0%, #ffffff 50%, #f7f7f7 100%);" aria-hidden="true">✓</span>
                  </button>
                </div>
              </div>
            </fieldset>
          </div>

          <div class="dc-builder-col dc-builder-col--mount-order dc-builder-col--size-order">
            <fieldset class="dc-builder-group">
              <legend><span class="dc-builder-step-title"><span class="dc-builder-step-badge" aria-hidden="true">3</span>Size</span></legend>
              <div class="dc-builder-sizes" role="radiogroup" aria-label="Select size">
                {%- liquid
                  assign preferred_keys = '1x6,1x8,1x4,2x8' | split: ','
                  assign rendered_variant_ids = ''
                -%}

                {%- comment -%} Render in preferred order (1x6, 1x8, 1x4, 2x8) {%- endcomment -%}
                {%- for pref_key in preferred_keys -%}
                  {%- for variant in badge_product.variants -%}
                    {%- if variant.title contains pref_key -%}
                      {%- liquid
                        assign max_chars = 16
                        if variant.title contains '8 Letters'
                          assign max_chars = 8
                        elsif variant.title contains '12 Letters'
                          assign max_chars = 12
                        elsif variant.title contains '16 Letters'
                          assign max_chars = 16
                        endif
                        assign is_checked = false
                        if variant.id == default_variant.id
                          assign is_checked = true
                        endif
                        assign rendered_variant_ids = rendered_variant_ids | append: variant.id | append: ','
                      -%}
                      <label class="dc-builder-size-label">
                        <input
                          type="radio"
                          name="size_variant"
                          value="{{ variant.id }}"
                          data-size-id="{{ variant.id }}"
                          data-size-title="{{ variant.title | escape }}"
                          data-size-price="{{ variant.price | money_with_currency }}"
                          data-size-max="{{ max_chars }}"
                          data-size-available="{{ variant.available }}"
                          {% if is_checked %}checked{% endif %}
                        >
                        <span class="dc-builder-size-card">
                          {%- liquid
                            assign title_parts = variant.title | split: ' ('
                            assign size_dim = title_parts[0]
                            assign size_meta = title_parts[1]
                          -%}
                          <span class="dc-builder-size-dim">{{ size_dim | escape }}</span>
                          {%- if size_meta != blank -%}
                            <span class="dc-builder-size-meta">({{ size_meta | escape }}</span>
                          {%- endif -%}
                        </span>
                      </label>
                    {%- endif -%}
                  {%- endfor -%}
                {%- endfor -%}

                {%- comment -%} Fallback for any other variants {%- endcomment -%}
                {%- for variant in badge_product.variants -%}
                  {%- unless rendered_variant_ids contains variant.id -%}
                    {%- liquid
                      assign max_chars = 16
                      if variant.title contains '8 Letters'
                        assign max_chars = 8
                      elsif variant.title contains '12 Letters'
                        assign max_chars = 12
                      elsif variant.title contains '16 Letters'
                        assign max_chars = 16
                      endif
                      assign is_checked = false
                      if variant.id == default_variant.id and rendered_variant_ids == blank
                        assign is_checked = true
                      endif
                    -%}
                    <label class="dc-builder-size-label">
                      <input
                        type="radio"
                        name="size_variant"
                        value="{{ variant.id }}"
                        data-size-id="{{ variant.id }}"
                        data-size-title="{{ variant.title | escape }}"
                        data-size-price="{{ variant.price | money_with_currency }}"
                        data-size-max="{{ max_chars }}"
                        data-size-available="{{ variant.available }}"
                        {% if is_checked %}checked{% endif %}
                      >
                      <span class="dc-builder-size-card">
                        {%- liquid
                          assign fallback_parts = variant.title | split: ' ('
                          assign fallback_dim = fallback_parts[0]
                          assign fallback_meta = fallback_parts[1]
                        -%}
                        <span class="dc-builder-size-dim">{{ fallback_dim | escape }}</span>
                        {%- if fallback_meta != blank -%}
                          <span class="dc-builder-size-meta">({{ fallback_meta | escape }}</span>
                        {%- endif -%}
                      </span>
                    </label>
                  {%- endunless -%}
                {%- endfor -%}
              </div>
            </fieldset>

            <input type="hidden" name="id" value="{{ default_variant.id }}" data-variant-id>
            <input type="hidden" name="quantity" value="1" data-quantity>
                <input type="hidden" name="properties[Font]" data-property="font">
                <input type="hidden" name="properties[Text Color]" data-property="face">
                <input type="hidden" name="properties[Background Color]" data-property="back">
                <input type="hidden" name="properties[_dc_emblem_mode]" data-property="mode" value="modern">
            <p class="dc-builder-error" id="BadgeError-{{ section.id }}" data-error role="alert"></p>
            <button type="submit" class="button button--primary dc-builder-submit" data-submit disabled>
              <span data-submit-label>{% if badge_product == blank %}Ordering coming soon{% else %}Build My Badge{% endif %}</span><span aria-hidden="true">→</span>
            </button>
            {% if badge_product != blank %}
              <p class="dc-builder-order-summary" data-order-summary>
                Total: <strong data-summary-price>{{ default_variant.price | money_with_currency }}</strong>
              </p>
            {% endif %}
          </div>
        </fieldset>
        <noscript><p>Enable JavaScript to customize and preview your badge before ordering.</p></noscript>
      </form>
    </dc-emblem-builder>
    {% if request.design_mode and badge_product == blank %}
      <p>Select a dedicated two-layer badge product in this section's settings to enable ordering. All fonts, finishes and size options must be included in its variant prices.</p>
    {% endif %}
    {% if is_product_page %}
      <div class="dc-builder-description rte{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"{% if settings.animations_reveal_on_scroll %} data-cascade{% endif %}>{{ product.description }}</div>
      <script type="application/ld+json">{{ product | structured_data }}</script>
    {% endif %}
    {% for block in section.blocks %}{% render block %}{% endfor %}
  </div>
</section>

{% schema %}
{
  "name": "Dizzy Emblem Builder",
  "tag": "div",
  "disabled_on": {"groups": ["header", "footer"]},
  "settings": [
    {"type": "product", "id": "product", "label": "Two-layer badge product", "info": "Leave blank to automatically use the product selected in Theme Settings > Custom Emblem. Or select a product here to override."},
    {"type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "YOUR WORDS. YOUR STYLE."},
    {"type": "text", "id": "heading", "label": "Heading", "default": "Make it unmistakably yours."},
    {"type": "richtext", "id": "description", "label": "Description", "default": "<p>Your text, your font, your colors. Build a two-layer badge and see your design come to life.</p>"},
    {"type": "text", "id": "default_text", "label": "Starting text", "default": "DIZZY"},
    {"type": "range", "id": "max_length", "label": "Maximum characters", "min": 4, "max": 32, "step": 1, "default": 16},
    {"type": "checkbox", "id": "demo", "label": "Show rotating examples before interaction", "default": false},
    {"type": "text", "id": "preview_note", "label": "Preview note", "default": "Digital preview. Actual colors and finishes may vary slightly."},
    {"type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "background-1"},
    {"type": "range", "id": "padding", "label": "Section spacing", "min": 0, "max": 100, "step": 4, "default": 48}
  ],
  "blocks": [{"type": "@app"}],
  "presets": [{"name": "Dizzy Emblem Builder"}]
}
{% endschema %}
