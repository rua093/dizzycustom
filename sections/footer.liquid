{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} .dizzy-footer {
    --dizzy-footer-bg: {{ section.settings.footer_background }};
    --dizzy-footer-newsletter-bg: {{ section.settings.newsletter_background }};
    --dizzy-footer-accent: {{ section.settings.accent_color }};
    --dizzy-footer-text: {{ section.settings.text_color }};
    --dizzy-footer-muted: {{ section.settings.muted_text_color }};
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
  }

  #shopify-section-{{ section.id }} .dizzy-footer__newsletter-band {
    --dizzy-footer-newsletter-image: url('{{ 'footer_email.webp' | asset_url }}');
  }

  #shopify-section-{{ section.id }} .dizzy-footer__inner {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  {% if section.settings.newsletter_background_image != blank %}
    #shopify-section-{{ section.id }} .dizzy-footer__newsletter-band {
      background-image:
        linear-gradient(90deg, rgba(4, 18, 31, 0.97) 0%, rgba(7, 31, 52, 0.91) 58%, rgba(7, 31, 52, 0.74) 100%),
        url('{{ section.settings.newsletter_background_image | image_url: width: 2400 }}');
    }
  {% endif %}

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .dizzy-footer {
      margin-top: {{ section.settings.margin_top }}px;
    }

    #shopify-section-{{ section.id }} .dizzy-footer__inner {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

{%- liquid
  assign has_social_icons = true
  if settings.social_facebook_link == blank and settings.social_instagram_link == blank and settings.social_youtube_link == blank and settings.social_tiktok_link == blank and settings.social_twitter_link == blank and settings.social_pinterest_link == blank and settings.social_snapchat_link == blank and settings.social_tumblr_link == blank and settings.social_vimeo_link == blank
    assign has_social_icons = false
  endif

  assign has_brand_block = false
  for block in section.blocks
    if block.type == 'brand_information' or block.type == 'image'
      assign has_brand_block = true
      break
    endif
  endfor
-%}

<footer class="dizzy-footer color-{{ section.settings.color_scheme }}">
  {%- if section.settings.newsletter_enable -%}
    <div class="dizzy-footer__newsletter-band">
      <div class="page-width dizzy-footer__newsletter-layout">
        <div class="dizzy-footer__newsletter-copy">
          {%- if section.settings.newsletter_heading != blank -%}
            <h2 id="DizzyFooterTitle-{{ section.id }}" class="dizzy-footer__newsletter-heading inline-richtext">
              {{ section.settings.newsletter_heading }}
            </h2>
          {%- endif -%}
          {%- if section.settings.newsletter_text != blank -%}
            <div class="dizzy-footer__newsletter-text rte">
              {{ section.settings.newsletter_text }}
            </div>
          {%- endif -%}
        </div>

        {%- form 'customer', id: 'DizzyContactFooter', class: 'dizzy-footer__newsletter-form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">
          <div class="dizzy-footer__newsletter-controls">
            <label class="visually-hidden" for="NewsletterForm--{{ section.id }}">
              {{ 'newsletter.label' | t }}
            </label>
            <input
              id="NewsletterForm--{{ section.id }}"
              type="email"
              name="contact[email]"
              class="dizzy-footer__newsletter-input"
              value="{{ form.email }}"
              aria-required="true"
              autocorrect="off"
              autocapitalize="off"
              autocomplete="email"
              {% if form.errors %}
                autofocus
                aria-invalid="true"
                aria-describedby="DizzyContactFooter-error"
              {% elsif form.posted_successfully? %}
                aria-describedby="DizzyContactFooter-success"
              {% endif %}
              placeholder="{{ 'newsletter.label' | t }}"
              required
            >
            <button type="submit" class="dizzy-footer__newsletter-button" name="commit">
              {{ 'newsletter.button_label' | t }}
            </button>
          </div>

          {%- if form.errors -%}
            <small class="dizzy-footer__form-message form__message" id="DizzyContactFooter-error">
              {%- render 'icon-error' -%}
              {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
            </small>
          {%- endif -%}

          {%- if form.posted_successfully? -%}
            <h3
              class="dizzy-footer__form-message dizzy-footer__form-message--success form__message"
              id="DizzyContactFooter-success"
              tabindex="-1"
              autofocus
            >
              {% render 'icon-success' %}
              {{- 'newsletter.success' | t }}
            </h3>
          {%- endif -%}
        {%- endform -%}
      </div>
    </div>
  {%- endif -%}

  <div class="dizzy-footer__inner">
    <div class="page-width">
      <div class="dizzy-footer__main-grid">
        {%- unless has_brand_block -%}
          <div class="dizzy-footer__brand">
            {%- if settings.logo != blank -%}
              {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {%- capture logo_style -%}--dizzy-footer-brand-logo-width: {{ settings.logo_width }}px;{%- endcapture -%}
              {{
                settings.logo
                | image_url: width: 600
                | image_tag:
                  class: 'dizzy-footer__brand-logo',
                  loading: 'lazy',
                  widths: '120, 180, 240, 360, 480, 600',
                  alt: logo_alt,
                  style: logo_style
              }}
            {%- else -%}
              <a class="dizzy-footer__brand-name" href="{{ routes.root_url }}">{{ shop.name }}</a>
            {%- endif -%}

            {%- if section.settings.brand_text != blank -%}
              <div class="dizzy-footer__brand-text rte">{{ section.settings.brand_text }}</div>
            {%- endif -%}

            {%- if section.settings.show_social and has_social_icons -%}
              {%- render 'social-icons', class: 'dizzy-footer__social-list' -%}
            {%- endif -%}

            {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
              <div class="dizzy-footer__follow-on-shop">
                {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
                {% # theme-check-disable %}
                {{ shop | login_button: action: 'follow' }}
                {% # theme-check-enable %}
              </div>
            {%- endif -%}
          </div>
        {%- endunless -%}

        {%- assign brand_rendered = false -%}
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              <div class="dizzy-footer__column dizzy-footer__column--app" {{ block.shopify_attributes }}>
                {% render block %}
              </div>

            {%- when 'link_list' -%}
              <nav class="dizzy-footer__column dizzy-footer__menu" aria-label="{{ block.settings.heading | strip_html | default: 'Footer navigation' | escape }}" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="dizzy-footer__column-heading inline-richtext">{{ block.settings.heading }}</h2>
                {%- endif -%}
                {%- if block.settings.menu != blank -%}
                  <ul class="dizzy-footer__links list-unstyled" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li>
                        <a
                          href="{{ link.url }}"
                          class="dizzy-footer__link{% if link.active %} dizzy-footer__link--active{% endif %}"
                          {% if link.current %}aria-current="page"{% endif %}
                        >
                          {{ link.title }}
                        </a>
                      </li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              </nav>

            {%- when 'text' -%}
              <div class="dizzy-footer__column dizzy-footer__text-column" {{ block.shopify_attributes }}>
                {%- if block.settings.heading != blank -%}
                  <h2 class="dizzy-footer__column-heading inline-richtext">{{ block.settings.heading }}</h2>
                {%- endif -%}
                <div class="dizzy-footer__richtext rte">{{ block.settings.subtext }}</div>
              </div>

            {%- when 'brand_information' -%}
              {%- if brand_rendered == false -%}
                <div class="dizzy-footer__brand" {{ block.shopify_attributes }}>
                  {%- if settings.brand_image != blank -%}
                    {%- assign brand_image_height = settings.brand_image_width | divided_by: settings.brand_image.aspect_ratio -%}
                    {%- capture brand_logo_style -%}--dizzy-footer-brand-logo-width: {{ settings.brand_image_width }}px;{%- endcapture -%}
                    {{
                      settings.brand_image
                      | image_url: width: 1100
                      | image_tag:
                        class: 'dizzy-footer__brand-logo',
                        loading: 'lazy',
                        widths: '120, 180, 240, 360, 480, 600, 800, 1100',
                        height: brand_image_height,
                        width: settings.brand_image_width,
                        style: brand_logo_style
                    }}
                  {%- elsif settings.logo != blank -%}
                    {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                    {%- capture logo_style -%}--dizzy-footer-brand-logo-width: {{ settings.logo_width }}px;{%- endcapture -%}
                    {{
                      settings.logo
                      | image_url: width: 600
                      | image_tag:
                        class: 'dizzy-footer__brand-logo',
                        loading: 'lazy',
                        widths: '120, 180, 240, 360, 480, 600',
                        alt: logo_alt,
                        style: logo_style
                    }}
                  {%- endif -%}

                  {%- if settings.brand_headline != blank -%}
                    <h2 class="dizzy-footer__column-heading">{{ settings.brand_headline }}</h2>
                  {%- endif -%}

                  {%- if settings.brand_description != blank and settings.brand_description != '<p></p>' -%}
                    <div class="dizzy-footer__brand-text rte">{{ settings.brand_description }}</div>
                  {%- elsif section.settings.brand_text != blank -%}
                    <div class="dizzy-footer__brand-text rte">{{ section.settings.brand_text }}</div>
                  {%- endif -%}

                  {%- if block.settings.show_social and has_social_icons -%}
                    {%- render 'social-icons', class: 'dizzy-footer__social-list' -%}
                  {%- endif -%}

                  {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
                    <div class="dizzy-footer__follow-on-shop">
                      {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
                      {% # theme-check-disable %}
                      {{ shop | login_button: action: 'follow' }}
                      {% # theme-check-enable %}
                    </div>
                  {%- endif -%}
                </div>
                {%- assign brand_rendered = true -%}
              {%- endif -%}

            {%- when 'image' -%}
              {%- if brand_rendered == false -%}
                <div class="dizzy-footer__brand" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 1100 -%}
                    <img
                      class="dizzy-footer__brand-logo"
                      srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                      src="{{ block.settings.image | image_url: width: block.settings.image_width }}"
                      alt="{{ block.settings.image.alt | default: shop.name | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      style="--dizzy-footer-brand-logo-width: {{ block.settings.image_width }}px;"
                    >
                  {%- elsif settings.logo != blank -%}
                    {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
                    {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
                    {% capture sizes %}(max-width: {{ settings.logo_width | times: 2 }}px) 50vw, {{ settings.logo_width }}px{% endcapture %}
                    {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
                    {%- capture logo_style -%}--dizzy-footer-brand-logo-width: {{ settings.logo_width }}px;{%- endcapture -%}
                    {{
                      settings.logo
                      | image_url: width: 600
                      | image_tag:
                        class: 'dizzy-footer__brand-logo',
                        widths: widths,
                        height: logo_height,
                        width: settings.logo_width,
                        alt: logo_alt,
                        sizes: sizes,
                        style: logo_style,
                        loading: 'lazy'
                    }}
                  {%- endif -%}

                  {%- if section.settings.brand_text != blank -%}
                    <div class="dizzy-footer__brand-text rte">{{ section.settings.brand_text }}</div>
                  {%- endif -%}

                  {%- if section.settings.show_social and has_social_icons -%}
                    {%- render 'social-icons', class: 'dizzy-footer__social-list' -%}
                  {%- endif -%}

                  {%- if shop.features.follow_on_shop? and section.settings.enable_follow_on_shop -%}
                    <div class="dizzy-footer__follow-on-shop">
                      {% comment %} TODO: enable theme-check once `login_button` is accepted as valid filter {% endcomment %}
                      {% # theme-check-disable %}
                      {{ shop | login_button: action: 'follow' }}
                      {% # theme-check-enable %}
                    </div>
                  {%- endif -%}
                </div>
                {%- assign brand_rendered = true -%}
              {%- else -%}
                <div class="dizzy-footer__column dizzy-footer__image-column {{ block.settings.alignment }}" {{ block.shopify_attributes }}>
                  {%- if block.settings.image != blank -%}
                    {%- assign image_size_2x = block.settings.image_width | times: 2 | at_most: 1100 -%}
                    <img
                      srcset="{{ block.settings.image | image_url: width: block.settings.image_width }}, {{ block.settings.image | image_url: width: image_size_2x }} 2x"
                      src="{{ block.settings.image | image_url: width: block.settings.image_width }}"
                      alt="{{ block.settings.image.alt | escape }}"
                      loading="lazy"
                      width="{{ block.settings.image.width }}"
                      height="{{ block.settings.image.height }}"
                      style="max-width: min(100%, {{ block.settings.image_width }}px);"
                    >
                  {%- endif -%}
                </div>
              {%- endif -%}
          {%- endcase -%}
        {%- endfor -%}

        <aside class="dizzy-footer__shipping" aria-label="{{ section.settings.shipping_heading | escape }}">
          <div class="dizzy-footer__shipping-header">
            <span class="dizzy-footer__shipping-icon" aria-hidden="true">
              <div class="dizzy-footer__shipping-icon" aria-hidden="true">
                {% render 'icon-world', class: 'dizzy-footer__shipping-svg' %}
              </div>
            </span>
            <div>
              {%- if section.settings.shipping_heading != blank -%}
                <h2 class="dizzy-footer__column-heading">{{ section.settings.shipping_heading }}</h2>
              {%- endif -%}
              {%- if section.settings.shipping_text != blank -%}
                <div class="dizzy-footer__shipping-text rte">{{ section.settings.shipping_text }}</div>
              {%- endif -%}
            </div>
          </div>

          {%- if section.settings.payment_enable -%}
            <div class="dizzy-footer__payment">
              <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
              <ul class="list list-payment" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="list-payment__item">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </aside>
      </div>

      {%- if section.settings.enable_country_selector or section.settings.enable_language_selector -%}
        <div class="dizzy-footer__localization">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterCountryForm', class: 'localization-form' -%}
                <div class="no-js-hidden">
                  <h2 class="visually-hidden" id="FooterCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'FooterCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form>
              {%- form 'localization', id: 'FooterLanguageForm', class: 'localization-form' -%}
                <div class="no-js-hidden">
                  <h2 class="visually-hidden" id="FooterLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'FooterLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>
      {%- endif -%}

      <div class="dizzy-footer__bottom-bar">
        <small class="dizzy-footer__copyright">
          &copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. All rights reserved.
        </small>

        {%- liquid
          assign has_footer_policies = false
          if shop.privacy_policy != blank or shop.terms_of_service != blank
            assign has_footer_policies = true
          endif
        -%}
        {%- if section.settings.show_policy and has_footer_policies -%}
          <ul class="dizzy-footer__policies list-unstyled" role="list">
            {%- if shop.privacy_policy != blank -%}
              <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title | escape }}</a></li>
            {%- endif -%}
            {%- if shop.terms_of_service != blank -%}
              <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title | escape }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Quick links",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label",
          "info": "t:sections.footer.blocks.link_list.settings.menu.info"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "header",
          "content": "t:sections.footer.blocks.brand_information.settings.header__1.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "Heading",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "<p>Share contact information, store details, and brand content with your customers.</p>",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Image width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Image alignment on large screen",
          "options": [
            { "value": "", "label": "Left" },
            { "value": "center", "label": "Center" },
            { "value": "right", "label": "Right" }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "background-1"
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "Join the DizzyCustom Community",
      "label": "Heading"
    },
    {
      "type": "richtext",
      "id": "newsletter_text",
      "default": "<p>Get exclusive offers, new product updates, and inspiration for your next build.</p>",
      "label": "Text"
    },
    {
      "type": "image_picker",
      "id": "newsletter_background_image",
      "label": "Newsletter background image"
    },
    {
      "type": "header",
      "content": "Brand and shipping"
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "default": "<p>Custom emblems. Real stories.<br>Thank you for being part of the DizzyCustom family.</p>",
      "label": "Brand text"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "t:sections.footer.settings.show_social.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content",
      "info": "t:sections.footer.settings.header__9.info"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
      "label": "t:sections.footer.settings.enable_follow_on_shop.label"
    },
    {
      "type": "inline_richtext",
      "id": "shipping_heading",
      "default": "Worldwide Shipping",
      "label": "Shipping heading"
    },
    {
      "type": "richtext",
      "id": "shipping_text",
      "default": "<p>Proudly serving customers in 150+ countries.</p>",
      "label": "Shipping text"
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "footer_background",
      "default": "#06131f",
      "label": "Footer background"
    },
    {
      "type": "color",
      "id": "newsletter_background",
      "default": "#0a2740",
      "label": "Newsletter background"
    },
    {
      "type": "color",
      "id": "accent_color",
      "default": "#1297e8",
      "label": "Accent color"
    },
    {
      "type": "color",
      "id": "text_color",
      "default": "#ffffff",
      "label": "Text color"
    },
    {
      "type": "color",
      "id": "muted_text_color",
      "default": "#b8c3cd",
      "label": "Muted text color"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__3.content",
      "info": "t:sections.footer.settings.header__4.info"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": true,
      "label": "t:sections.footer.settings.enable_country_selector.label"
    },
    {
