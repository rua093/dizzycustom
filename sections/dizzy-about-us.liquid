{{ 'section-dizzy-about.css' | asset_url | stylesheet_tag }}

<section
  class="dizzy-about"
  style="--dizzy-about-accent: {{ section.settings.accent_color }}; --dizzy-about-ink: {{ section.settings.ink_color }}; --dizzy-about-muted: {{ section.settings.muted_color }}; --dizzy-about-soft: {{ section.settings.soft_background }};"
>
  <div class="dizzy-about__hero">
    <div class="dizzy-about__hero-media" aria-hidden="true">
      {%- if section.settings.hero_image != blank -%}
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            widths: '750, 1100, 1500, 2000, 2400',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            class: 'dizzy-about__hero-image',
            alt: ''
        }}
      {%- else -%}
        <img
          src="{{ 'dizzycustom-about-hero-custom-edition.webp' | asset_url }}"
          alt=""
          width="1672"
          height="941"
          loading="eager"
          fetchpriority="high"
          class="dizzy-about__hero-image"
        >
      {%- endif -%}
    </div>
    <div class="dizzy-about__hero-overlay"></div>

    <div class="page-width dizzy-about__hero-inner">
      <div class="dizzy-about__hero-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
        {%- if section.settings.hero_eyebrow != blank -%}
          <p class="dizzy-about__eyebrow dizzy-about__eyebrow--light">{{ section.settings.hero_eyebrow | escape }}</p>
        {%- endif -%}

        <h1 class="dizzy-about__hero-title">{{ section.settings.hero_heading | default: page.title | escape }}</h1>

        {%- if section.settings.hero_subheading != blank -%}
          <p class="dizzy-about__hero-subheading">{{ section.settings.hero_subheading | escape }}</p>
        {%- endif -%}

        {%- if section.settings.hero_text != blank -%}
          <div class="dizzy-about__hero-text rte">{{ section.settings.hero_text }}</div>
        {%- endif -%}

        {%- if section.settings.hero_button_label != blank and section.settings.hero_button_link != blank -%}
          <a class="dizzy-about__button dizzy-about__button--primary" href="{{ section.settings.hero_button_link }}">
            {{ section.settings.hero_button_label | escape }}
            <span aria-hidden="true">→</span>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  <div class="page-width dizzy-about__story">
    <div class="dizzy-about__story-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.story_eyebrow != blank -%}
        <p class="dizzy-about__eyebrow">{{ section.settings.story_eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.story_heading != blank -%}
        <h2 class="dizzy-about__heading">{{ section.settings.story_heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.story_text != blank -%}
        <div class="dizzy-about__body rte">{{ section.settings.story_text }}</div>
      {%- endif -%}

      {%- if section.settings.story_button_label != blank and section.settings.story_button_link != blank -%}
        <a class="dizzy-about__button dizzy-about__button--secondary" href="{{ section.settings.story_button_link }}">
          {{ section.settings.story_button_label | escape }}
        </a>
      {%- endif -%}
    </div>

    <div class="dizzy-about__story-media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if section.settings.story_image != blank -%}
        {{
          section.settings.story_image
          | image_url: width: 1600
          | image_tag:
            widths: '550, 750, 990, 1200, 1600',
            sizes: '(min-width: 990px) 52vw, 100vw',
            loading: 'lazy',
            class: 'dizzy-about__story-image',
            alt: section.settings.story_image.alt
        }}
      {%- else -%}
        <img
          src="{{ 'dizzycustom-about-story-emblem-workshop.webp' | asset_url }}"
          alt="Custom metal emblem being crafted in the DizzyCustom workshop"
          width="1448"
          height="1086"
          loading="lazy"
          class="dizzy-about__story-image"
        >
      {%- endif -%}
    </div>
  </div>

  <div class="dizzy-about__benefits-wrap">
    <div class="page-width dizzy-about__benefits" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'benefit' -%}
          <div
            class="dizzy-about__benefit{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            role="listitem"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <span class="dizzy-about__benefit-icon" aria-hidden="true">
              {%- case block.settings.icon -%}
                {%- when 'quality' -%}
                  {%- render 'icon-diamond', class: 'dizzy-about__benefit-svg' -%}
                {%- when 'installation' -%}
                  {%- render 'icon-gear', class: 'dizzy-about__benefit-svg' -%}
                {%- when 'customize' -%}
                  {%- render 'icon-pencil', class: 'dizzy-about__benefit-svg' -%}
                {%- when 'shipping' -%}
                  {%- render 'icon-truck', class: 'dizzy-about__benefit-svg' -%}
              {%- endcase -%}
            </span>
            <h3>{{ block.settings.heading | escape }}</h3>
            {%- if block.settings.text != blank -%}
              <div class="rte">{{ block.settings.text }}</div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="dizzy-about__stats-wrap">
    <div class="page-width dizzy-about__stats" role="list">
      {%- for block in section.blocks -%}
        {%- if block.type == 'stat' -%}
          <div
            class="dizzy-about__stat{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}"
            role="listitem"
            {{ block.shopify_attributes }}
            {% if settings.animations_reveal_on_scroll %}
              data-cascade
              style="--animation-order: {{ forloop.index }};"
            {% endif %}
          >
            <strong>{{ block.settings.value | escape }}</strong>
            <span>{{ block.settings.label | escape }}</span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  <div class="page-width dizzy-about__details">
    <div class="dizzy-about__details-media{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--fade-in{% endif %}">
      {%- if section.settings.details_image != blank -%}
        {{
          section.settings.details_image
          | image_url: width: 1600
          | image_tag:
            widths: '550, 750, 990, 1200, 1600',
            sizes: '(min-width: 990px) 50vw, 100vw',
            loading: 'lazy',
            class: 'dizzy-about__details-image',
            alt: section.settings.details_image.alt
        }}
      {%- else -%}
        <img
          src="{{ 'dizzycustom-about-lifestyle-motorcycle-emblem.webp' | asset_url }}"
          alt="Custom motorcycle emblem lifestyle detail"
          width="1448"
          height="1086"
          loading="lazy"
          class="dizzy-about__details-image"
        >
      {%- endif -%}
    </div>

    <div class="dizzy-about__details-copy{% if settings.animations_reveal_on_scroll %} scroll-trigger animate--slide-in{% endif %}">
      {%- if section.settings.details_eyebrow != blank -%}
        <p class="dizzy-about__eyebrow">{{ section.settings.details_eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.details_heading != blank -%}
        <h2 class="dizzy-about__heading">{{ section.settings.details_heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.details_text != blank -%}
        <div class="dizzy-about__body rte">{{ section.settings.details_text }}</div>
      {%- endif -%}

      <ul class="dizzy-about__checklist" role="list">
        {%- for block in section.blocks -%}
          {%- if block.type == 'detail' and block.settings.text != blank -%}
            <li {{ block.shopify_attributes }}>
              <span class="dizzy-about__check" aria-hidden="true">✓</span>
              <span>{{ block.settings.text | escape }}</span>
            </li>
          {%- endif -%}
        {%- endfor -%}
      </ul>

      {%- if section.settings.details_button_label != blank and section.settings.details_button_link != blank -%}
        <a class="dizzy-about__button dizzy-about__button--dark" href="{{ section.settings.details_button_link }}">
          {{ section.settings.details_button_label | escape }}
          <span aria-hidden="true">→</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
