{%- comment -%}
  DizzyCustom Luxury Automotive Newsletter Popup & Floating Launcher Tag
  - Native Shopify Customer Form Integration (tags: newsletter, popup_welcome10)
  - 100% Client-side AJAX submission (0 page reload)
  - Customizable in Shopify Theme Editor: Image, Discount Code, Texts, Timing (7s)
  - Dismissed state displays a sleek floating tag on bottom-left of screen
  - Re-opening supported by clicking floating tag
  - Duplicate subscription detection matching store design
{%- endcomment -%}

{%- if section.settings.enable -%}
  {{ 'section-newsletter-popup.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'newsletter-popup.js' | asset_url }}" defer="defer"></script>

  <div
    class="dizzy-popup-wrapper"
    data-dizzy-popup-container
    data-enabled="{{ section.settings.enable }}"
    data-delay="{{ section.settings.delay_seconds }}"
    data-discount-code="{{ section.settings.discount_code | escape }}"
  >
    <!-- FLOATING LAUNCHER TAG (BOTTOM LEFT) -->
    <button
      class="dizzy-popup-launcher"
      type="button"
      aria-label="{{ section.settings.badge_text }}"
      title="{{ section.settings.badge_text }}"
    >
      <span class="dizzy-popup-launcher__ping"></span>
      <span class="dizzy-popup-launcher__icon">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
          <line x1="7" y1="7" x2="7.01" y2="7"></line>
        </svg>
      </span>
      <span>{{ section.settings.badge_text }}</span>
    </button>

    <!-- BACKDROP & MODAL OVERLAY -->
    <div
      class="dizzy-popup-backdrop"
      id="DizzyPopupBackdrop"
      role="dialog"
      aria-modal="true"
      aria-labelledby="DizzyPopupHeading"
    >
      <div class="dizzy-popup-modal">
        <!-- Close (X) Button -->
        <button
          class="dizzy-popup__close-btn"
          type="button"
          aria-label="{{ 'accessibility.close' | t | default: 'Close' }}"
        >
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>

        <div class="dizzy-popup__grid">
          <!-- LEFT CONTENT PANEL -->
          <div class="dizzy-popup__content">
            <!-- 1. FORM VIEW -->
            <div id="DizzyPopupViewForm">
              {%- if section.settings.eyebrow_text != blank -%}
                <span class="dizzy-popup__eyebrow">{{ section.settings.eyebrow_text }}</span>
              {%- endif -%}

              <h2 class="dizzy-popup__title" id="DizzyPopupHeading">
                {{ section.settings.heading }}
              </h2>

              {%- if section.settings.subheading != blank -%}
                <p class="dizzy-popup__subtitle">
                  {{ section.settings.subheading }}
                </p>
              {%- endif -%}

              {%- form 'customer', id: 'DizzyNewsletterPopupForm', class: 'dizzy-popup__form' -%}
                <input type="hidden" name="contact[tags]" value="newsletter,popup_welcome10">

                <div class="dizzy-popup__input-wrap">
                  <input
                    type="email"
                    name="contact[email]"
                    class="dizzy-popup__input"
                    placeholder="{{ section.settings.input_placeholder }}"
                    required
                    autocomplete="email"
                    autocapitalize="off"
                    autocorrect="off"
                    aria-required="true"
                  >
                  <div class="dizzy-popup__error-msg"></div>
                </div>

                <div class="dizzy-popup__actions">
                  <button type="button" class="dizzy-popup__btn-secondary">
                    {{ section.settings.cancel_text }}
                  </button>
                  <button type="submit" class="dizzy-popup__btn-primary">
                    {{ section.settings.button_text }}
                  </button>
                </div>
              {%- endform -%}
            </div>

            <!-- 2. SUCCESS VIEW -->
            <div id="DizzyPopupViewSuccess" class="dizzy-popup__state-view">
              {%- if section.settings.success_eyebrow != blank -%}
                <span class="dizzy-popup__eyebrow">{{ section.settings.success_eyebrow }}</span>
              {%- endif -%}

              <h2 class="dizzy-popup__title">
                {{ section.settings.success_title }}
              </h2>

              <p class="dizzy-popup__subtitle">
                {{ section.settings.success_text }}
              </p>

              <div class="dizzy-popup__discount-box">
                <div class="dizzy-popup__code-wrap">
                  <span class="dizzy-popup__code-label">{{ section.settings.discount_label }}</span>
                  <span class="dizzy-popup__code-text">{{ section.settings.discount_code }}</span>
                </div>
                <button
                  type="button"
                  class="dizzy-popup__copy-btn"
                  data-code="{{ section.settings.discount_code | escape }}"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Copy</span>
                </button>
              </div>

              <button type="button" class="dizzy-popup__btn-primary dizzy-popup__btn-continue" style="width: 100%;">
                {{ section.settings.continue_shopping_text }}
              </button>
            </div>

            <!-- 3. ALREADY SUBSCRIBED VIEW -->
            <div id="DizzyPopupViewAlreadySubscribed" class="dizzy-popup__state-view">
              <h2 class="dizzy-popup__title">
                {{ section.settings.already_subscribed_title }}
              </h2>

              <p class="dizzy-popup__subtitle">
                {{ section.settings.already_subscribed_text }}
              </p>

              <div class="dizzy-popup__discount-box">
                <div class="dizzy-popup__code-wrap">
                  <span class="dizzy-popup__code-label">{{ section.settings.discount_label }}</span>
                  <span class="dizzy-popup__code-text">{{ section.settings.discount_code }}</span>
                </div>
                <button
                  type="button"
                  class="dizzy-popup__copy-btn"
                  data-code="{{ section.settings.discount_code | escape }}"
                >
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                    <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                  </svg>
                  <span>Copy</span>
                </button>
              </div>

              <button type="button" class="dizzy-popup__btn-primary dizzy-popup__btn-continue" style="width: 100%;">
                {{ section.settings.continue_shopping_text }}
              </button>
            </div>
          </div>

          <!-- RIGHT IMAGE PANEL -->
          <div class="dizzy-popup__media">
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 800
                | image_tag:
                  loading: 'lazy',
                  sizes: '(min-width: 750px) 420px, 100vw',
                  widths: '320, 420, 640, 800',
                  alt: section.settings.image.alt | default: 'DizzyCustom Emblem'
              }}
            {%- else -%}
              <img
                src="//dizzycustom.com/cdn/shop/files/IMG_2255.png?width=700"
                alt="DizzyCustom Emblem"
                loading="lazy"
                width="700"
                height="500"
              >
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Luxury Newsletter Popup",
  "settings": [
    {
      "type": "checkbox",
      "id": "enable",
      "label": "Enable Newsletter Popup",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Popup Emblem Image",
      "info": "Choose emblem photo or product showcase from Shopify files."
    },
    {
      "type": "range",
      "id": "delay_seconds",
      "min": 1,
      "max": 30,
      "step": 1,
      "unit": "s",
      "label": "Popup Delay",
      "default": 7,
      "info": "Time in seconds before the popup automatically appears on first entry."
    },
    {
      "type": "header",
      "content": "Discount Settings"
    },
    {
      "type": "text",
      "id": "discount_code",
      "label": "Discount Code",
      "default": "DIZZYWELCOME10"
    },
    {
      "type": "text",
      "id": "discount_label",
      "label": "Discount Box Label",
      "default": "Your 10% Off Code"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Floating Left Badge Text",
      "default": "Get 10% Off",
      "info": "The small tag shown on the bottom-left when popup is closed."
    },
    {
      "type": "header",
      "content": "Main Popup Content"
    },
    {
      "type": "text",
      "id": "eyebrow_text",
      "label": "Eyebrow Tag (Optional)"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SIGN UP TO DIZZYCUSTOM"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "Subheading",
      "default": "Subscribe to our newsletter and get 10% off your first order."
    },
    {
      "type": "text",
      "id": "input_placeholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Submit Button Label",
      "default": "Claim 10% Off"
    },
    {
      "type": "text",
      "id": "cancel_text",
      "label": "Dismiss Button Label",
      "default": "No, thanks"
    },
    {
      "type": "header",
      "content": "Success State"
    },
    {
      "type": "text",
      "id": "success_eyebrow",
      "label": "Success Eyebrow (Optional)"
    },
    {
      "type": "text",
      "id": "success_title",
      "label": "Success Title",
      "default": "Success!"
    },
    {
      "type": "textarea",
      "id": "success_text",
      "label": "Success Message",
      "default": "Thanks for signing up, enjoy your claim in your inbox or right here!"
    },
    {
      "type": "header",
      "content": "Already Subscribed State"
    },
    {
      "type": "text",
      "id": "already_subscribed_title",
      "label": "Already Subscribed Title",
      "default": "You have already left us your contact information."
    },
    {
      "type": "textarea",
      "id": "already_subscribed_text",
      "label": "Already Subscribed Message",
      "default": "We appreciate your support! You can still use your 10% discount code below:"
    },
    {
      "type": "text",
      "id": "continue_shopping_text",
      "label": "Continue Shopping Button",
      "default": "Continue Shopping"
    }
  ],
  "presets": [
    {
      "name": "Luxury Newsletter Popup"
    }
  ]
}
{% endschema %}
