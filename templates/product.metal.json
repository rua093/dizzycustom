    "dc_installation_guide": {
      "type": "dc-installation-guide",
      "blocks": {
        "step_clean": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Detail-20_278ac171-8d43-4a03-9444-6c837876bf17.jpg",
            "heading": "Clean the Surface",
            "text": "<p>Clean the area with an alcohol-based cleaner and make sure it is dry and free of wax or oil.</p>"
          }
        },
        "step_mark": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Detail-21_159b30ca-20ac-43ec-b793-3747fbc2403c.jpg",
            "heading": "Mark the Position",
            "text": "<p>Use masking tape or a dry-erase marker to preview the placement and keep the emblem aligned.</p>"
          }
        },
        "step_apply": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Detail-22_1c6c6fbd-36f3-4631-a35c-d3a4e120005d.jpg",
            "heading": "Apply the Emblem",
            "text": "<p>Remove the protective backing, place the emblem carefully and press firmly for 30–60 seconds.</p>"
          }
        },
        "step_finish": {
          "type": "step",
          "settings": {
            "image": "shopify://shop_images/Detail-23_e78db51a-fab3-41c0-9f5a-72cb519cfb79.jpg",
            "heading": "Final Touch",
            "text": "<p>Remove the guides, give the emblem a final press and wait 24 hours before washing.</p>"
          }
        },
        "tip_flat": {
          "type": "tip",
          "settings": {
            "icon": "flat",
            "heading": "Estimate the Curve of the Surface",
            "text": "<p>Before removing the backing, gently place the emblem on the surface to get a feel for the curve.</p>"
          }
        },
        "tip_curve": {
          "type": "tip",
          "settings": {
            "icon": "curve",
            "heading": "Pre-Bend the Emblem to Match the Curve",
            "text": "<p>Slightly warm up the non-adhesive side of the emblem and bend it to follow the estimated curve.</p><p>Then shape the emblem to fit the curve, and press it down from the center outward to prevent wrinkles or lifted edges.</p>"
          }
        }
      },
