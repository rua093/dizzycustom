    "collapsible_content_EKCrAk": {
      "type": "dc-product-faq",
      "blocks": {
        "collapsible_row_XNL4FD": {
          "type": "faq_item",
          "settings": {
            "question": "How durable are these emblems?",
            "answer": "<p>Our emblems are crafted by hand from high-quality stainless steal, ensuring durability and resistance against various environmental conditions.</p>"
          }
        },
        "collapsible_row_mQ3Lnx": {
          "type": "faq_item",
          "settings": {
            "question": "Can I include symbols or dates in my customization?",
            "answer": "<p>Absolutely! Beyond names, you can include symbols, dates, or mottos to create a more personalized and meaningful emblem.</p>"
          }
        },
        "collapsible_row_aVbDzf": {
          "type": "faq_item",
          "settings": {
            "question": "Can I easily remove the emblem and attach it somewhere else?",
            "answer": "<p>Whatever your reason to remove the emblem from your car is, you’ll have to be really cautious. If you’re not, you could damage the paint.</p><p>We recommend that you consult a professional to help with this issue.</p>"
          }
        },
        "collapsible_row_fQeGWY": {
          "type": "faq_item",
          "settings": {
            "question": "Can the default sizes be changed if it doesn't fit for me?",
            "answer": "<p>Yes! We can do any size you’d like. Just contact us beforehand, because bigger emblems can be more expensive and some emblems we can only make emblems so small.</p>"
          }
        },
        "collapsible_row_gbLVtx": {
          "type": "faq_item",
          "settings": {
            "question": "Is the installation process complicated?",
            "answer": "<p>Not at all! We provide clear instructions and may even include an installation kit with your purchase.You just need to use double-sided on back side tape to \"peel and stick\" it on your car.</p>"
          }
        }
      },
