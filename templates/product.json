    "multicolumn_ykVdx7": {
      "type": "multicolumn",
      "blocks": {
        "column_RDMd7P": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Detail-20_278ac171-8d43-4a03-9444-6c837876bf17.jpg",
            "title": "<em>1. </em>Clean the Surface ✅",
            "text": "<p>Use an <strong>alcohol-based cleaner or adhesive remover</strong> to wipe the area where you’ll apply the emblem.</p><p>This ensures a <strong>strong bond</strong> and prevents dust or grease from interfering with adhesion.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_h9jMcT": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Detail-21_159b30ca-20ac-43ec-b793-3747fbc2403c.jpg",
            "title": "<em>2. </em>Mark the Position ✅",
            "text": "<p>Use <strong>masking tape or a dry-erase marker</strong> to outline the placement of your emblem.</p><p>These <strong>guidelines help ensure perfect alignment</strong> before applying the adhesive.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_q86ne8": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Detail-22_1c6c6fbd-36f3-4631-a35c-d3a4e120005d.jpg",
            "title": "<em>3. </em>Apply the Emblem ✅",
            "text": "<p>Remove the <strong>protective backing</strong> from the <strong>3M adhesive</strong> and carefully place the emblem in position.</p><p>Press firmly for <strong>30–60 seconds</strong> to secure the bond with the car’s surface.</p>",
            "link_label": "",
            "link": ""
          }
        },
        "column_X8e7La": {
          "type": "column",
          "settings": {
            "image": "shopify://shop_images/Detail-23_e78db51a-fab3-41c0-9f5a-72cb519cfb79.jpg",
            "title": "<em>4. </em>Final Touch ✅",
            "text": "<p>Remove any remaining tape or guides.</p><p>Give the emblem <strong>a final press</strong> and <strong>wait 24 hours</strong> before washing for best adhesion.</p>",
            "link_label": "",
            "link": ""
          }
        }
      },
      "block_order": [
