{% comment %}
  Renders cart drawer

  Usage:
  {% render 'cart-drawer' %}
{% endcomment %}

{{ 'quantity-popover.css' | asset_url | stylesheet_tag }}
{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

<script src="{{ 'cart.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'quantity-popover.js' | asset_url }}" defer="defer"></script>

{%- liquid
  assign free_shipping_goal = 2
  assign free_shipping_progress = cart.item_count | times: 100 | divided_by: free_shipping_goal | at_most: 100
  assign free_shipping_remaining = free_shipping_goal | minus: cart.item_count
-%}

<style>
  .drawer {
    visibility: hidden;
  }
</style>

<cart-drawer class="drawer dizzy-cart-drawer{% if cart == empty %} is-empty{% endif %}">
  <div id="CartDrawer" class="cart-drawer dizzy-cart-drawer__shell">
    <div id="CartDrawer-Overlay" class="cart-drawer__overlay"></div>
    <div
      class="drawer__inner dizzy-cart-drawer__inner gradient color-{{ settings.cart_color_scheme }}"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.cart.title' | t }}"
      tabindex="-1"
    >
      <div class="drawer__header dizzy-cart-drawer__header">
        <div class="dizzy-cart-drawer__title-wrap">
          <span class="dizzy-cart-drawer__cart-icon" aria-hidden="true">
            {% render 'icon-shopping-cart' %}
          </span>
          <h2 class="dizzy-cart-drawer__heading">Your Cart</h2>
          <span class="dizzy-cart-drawer__divider" aria-hidden="true"></span>
          <span class="dizzy-cart-drawer__count" aria-label="{{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}">
            {{ cart.item_count }} item{% if cart.item_count != 1 %}s{% endif %}
          </span>
        </div>
        <button
          class="drawer__close dizzy-cart-drawer__close"
          type="button"
          onclick="this.closest('cart-drawer').close()"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          {% render 'icon-close' %}
        </button>
      </div>

      {%- if cart == empty -%}
        <div class="drawer__inner-empty dizzy-cart-drawer__empty">
          <div class="cart-drawer__warnings center">
            <div class="cart-drawer__empty-content dizzy-cart-drawer__empty-content">
              <h2 class="cart__empty-text dizzy-cart-drawer__empty-title">Your cart is currently empty.</h2>
              <a href="{{ routes.all_products_collection_url }}" class="button dizzy-cart-drawer__button dizzy-cart-drawer__button--primary">
                {{ 'general.continue_shopping' | t }}
              </a>

              {%- if shop.customer_accounts_enabled and customer == null -%}
                <p class="cart__login-title h3">{{ 'sections.cart.login.title' | t }}</p>
                <p class="cart__login-paragraph">
                  {{ 'sections.cart.login.paragraph_html' | t: link: routes.account_login_url }}
                </p>
              {%- endif -%}
            </div>
          </div>
        </div>
      {%- else -%}
        <div class="dizzy-cart-drawer__shipping" role="status">
          <span class="dizzy-cart-drawer__shipping-icon" aria-hidden="true">
            {% render 'icon-truck-speed', class: 'dizzy-cart-drawer__shipping-svg' %}
          </span>
          <div class="dizzy-cart-drawer__shipping-content">
            <p class="dizzy-cart-drawer__shipping-title">
              {%- if free_shipping_remaining > 0 -%}
                Add {{ free_shipping_remaining }} more emblem{% if free_shipping_remaining != 1 %}s{% endif %} to unlock
                <strong>FREE Shipping</strong>
              {%- else -%}
                <strong>FREE Shipping</strong> unlocked
              {%- endif -%}
            </p>
            <div class="dizzy-cart-drawer__shipping-track" aria-hidden="true">
              <span class="dizzy-cart-drawer__shipping-fill" style="width: {{ free_shipping_progress }}%;"></span>
            </div>
          </div>
        </div>

        <cart-drawer-items>
          <form
            action="{{ routes.cart_url }}"
            id="CartDrawer-Form"
            class="cart__contents cart-drawer__form dizzy-cart-drawer__form"
            method="post"
          >
            <div id="CartDrawer-CartItems" class="drawer__contents js-contents">
              <div class="drawer__cart-items-wrapper">
                <ul class="cart-items dizzy-cart-drawer__items list-unstyled" role="list">
                  {%- for item in cart.items -%}
                    <li id="CartDrawer-Item-{{ item.index | plus: 1 }}" class="cart-item dizzy-cart-drawer__item" role="listitem">
                      <div class="cart-item__media dizzy-cart-drawer__item-media">
                        {% if item.image %}
                          <a href="{{ item.url }}" class="cart-item__link" tabindex="-1" aria-hidden="true"> </a>
                          <img
                            class="cart-item__image dizzy-cart-drawer__item-image"
                            src="{{ item.image | image_url: width: 240 }}"
                            alt="{{ item.image.alt | escape }}"
                            loading="lazy"
                            width="120"
                            height="{{ 120 | divided_by: item.image.aspect_ratio | ceil }}"
                          >
                        {% endif %}
                      </div>

                      <div class="cart-item__details dizzy-cart-drawer__item-details">
                        {%- if settings.show_vendor -%}
                          <p class="caption-with-letter-spacing light">{{ item.product.vendor }}</p>
                        {%- endif -%}

                        <a href="{{ item.url }}" class="cart-item__name h4 break dizzy-cart-drawer__item-title">
                          {{- item.product.title | escape -}}
                        </a>

                        {%- if item.product.has_only_default_variant == false
                          or item.properties.size != 0
                          or item.selling_plan_allocation != null
                        -%}
                          <dl class="dizzy-cart-drawer__options">
                            {%- if item.product.has_only_default_variant == false -%}
                              {%- for option in item.options_with_values -%}
                                <div class="product-option dizzy-cart-drawer__option">
                                  <dt>{{ option.name }}:</dt>
                                  <dd>
                                    {{ option.value -}}
                                    {%- unless forloop.last %}, {% endunless %}
                                  </dd>
                                </div>
                              {%- endfor -%}
                            {%- endif -%}

                            {%- for property in item.properties -%}
                              {%- assign property_first_char = property.first | slice: 0 -%}
                              {%- if property.last != blank and property_first_char != '_' -%}
                                <div class="product-option dizzy-cart-drawer__option">
                                  <dt>{{ property.first }}:</dt>
                                  <dd>
                                    {%- if property.last contains '/uploads/' -%}
                                      <a
                                        href="{{ property.last }}"
                                        class="link"
                                        target="_blank"
                                        aria-describedby="a11y-new-window-message"
                                      >
                                        {{ property.last | split: '/' | last }}
                                      </a>
                                    {%- else -%}
                                      {{ property.last }}
                                    {%- endif -%}
                                  </dd>
                                </div>
                              {%- endif -%}
                            {%- endfor -%}
                          </dl>

                          <p class="product-option">{{ item.selling_plan_allocation.selling_plan.name }}</p>
                        {%- endif -%}

                        <ul
                          class="discounts list-unstyled"
                          role="list"
                          aria-label="{{ 'customer.order.discount' | t }}"
                        >
                          {%- for discount in item.line_level_discount_allocations -%}
                            <li class="discounts__discount">
                              {%- render 'icon-discount' -%}
                              {{ discount.discount_application.title }}
                            </li>
                          {%- endfor -%}
                        </ul>

                        {%- liquid
                          assign has_qty_rules = false
                          if item.variant.quantity_rule.increment > 1 or item.variant.quantity_rule.min > 1 or item.variant.quantity_rule.max != null
                            assign has_qty_rules = true
                          endif

                          assign has_vol_pricing = false
                          if item.variant.quantity_price_breaks.size > 0
                            assign has_vol_pricing = true
                          endif
                        -%}
                        <quantity-popover class="dizzy-cart-drawer__quantity-popover">
                          <div class="cart-item__quantity-wrapper quantity-popover-wrapper dizzy-cart-drawer__quantity-row">
                            <div class="quantity-popover-container{% if has_qty_rules or has_vol_pricing %} quantity-popover-container--hover{% endif %}">
                              <quantity-input class="quantity cart-quantity dizzy-cart-drawer__quantity">
                                <button class="quantity__button no-js-hidden" name="minus" type="button" data-cart-mutation-control>
                                  <span class="visually-hidden">
                                    {{-
                                      'products.product.quantity.decrease'
                                      | t: product: item.product.title
                                      | escape
                                    -}}
                                  </span>
                                  {% render 'icon-minus' %}
                                </button>
                                <input
                                  class="quantity__input"
                                  type="number"
                                  data-quantity-variant-id="{{ item.variant.id }}"
                                  name="updates[]"
                                  value="{{ item.quantity }}"
                                  {% # theme-check-disable %}
                                  data-cart-quantity="{{ cart | item_count_for_variant: item.variant.id }}"
                                  min="{{ item.variant.quantity_rule.min }}"
                                  {% if item.variant.quantity_rule.max != null %}
                                    max="{{ item.variant.quantity_rule.max }}"
                                  {% endif %}
                                  step="{{ item.variant.quantity_rule.increment }}"
                                  {% # theme-check-enable %}
                                  aria-label="{{ 'products.product.quantity.input_label' | t: product: item.product.title | escape }}"
                                  id="Drawer-quantity-{{ item.index | plus: 1 }}"
                                  data-index="{{ item.index | plus: 1 }}"
                                  data-cart-mutation-control
                                >
                                <button class="quantity__button no-js-hidden" name="plus" type="button" data-cart-mutation-control>
                                  <span class="visually-hidden">
                                    {{-
                                      'products.product.quantity.increase'
                                      | t: product: item.product.title
                                      | escape
                                    -}}
                                  </span>
                                  {% render 'icon-plus' %}
                                </button>
                              </quantity-input>
                            </div>

                            <div class="cart-item__totals right dizzy-cart-drawer__item-totals">
                              <div class="cart-item__price-wrapper">
                                {%- if item.original_line_price != item.final_line_price -%}
                                  <div class="cart-item__discounted-prices">
                                    <span class="visually-hidden">
                                      {{ 'products.product.price.regular_price' | t }}
                                    </span>
                                    <s class="cart-item__old-price price price--end">
                                      {{ item.original_line_price | money }}
                                    </s>
                                    <span class="visually-hidden">
                                      {{ 'products.product.price.sale_price' | t }}
                                    </span>
                                    <span class="price price--end">
                                      {{ item.final_line_price | money }}
                                    </span>
                                  </div>
                                {%- else -%}
                                  <span class="price price--end">
                                    {{ item.original_line_price | money }}
                                  </span>
                                {%- endif -%}
                              </div>
                            </div>
                          </div>

                          <div
                            id="CartDrawer-LineItemError-{{ item.index | plus: 1 }}"
                            class="cart-item__error"
                            role="alert"
                          >
                            <small class="cart-item__error-text"></small>
                            <svg
                              aria-hidden="true"
                              focusable="false"
                              class="icon icon-error"
                              viewBox="0 0 13 13"
                            >
                              <circle cx="6.5" cy="6.50049" r="5.5" stroke="white" stroke-width="2"/>
                              <circle cx="6.5" cy="6.5" r="5.5" fill="#EB001B" stroke="#EB001B" stroke-width="0.7"/>
                              <path d="M5.87413 3.52832L5.97439 7.57216H7.02713L7.12739 3.52832H5.87413ZM6.50076 9.66091C6.88091 9.66091 7.18169 9.37267 7.18169 9.00504C7.18169 8.63742 6.88091 8.34917 6.50076 8.34917C6.12061 8.34917 5.81982 8.63742 5.81982 9.00504C5.81982 9.37267 6.12061 9.66091 6.50076 9.66091Z" fill="white"/>
                              <path d="M5.87413 3.17832H5.51535L5.52424 3.537L5.6245 7.58083L5.63296 7.92216H5.97439H7.02713H7.36856L7.37702 7.58083L7.47728 3.537L7.48617 3.17832H7.12739H5.87413ZM6.50076 10.0109C7.06121 10.0109 7.5317 9.57872 7.5317 9.00504C7.5317 8.43137 7.06121 7.99918 6.50076 7.99918C5.94031 7.99918 5.46982 8.43137 5.46982 9.00504C5.46982 9.57872 5.94031 10.0109 6.50076 10.0109Z" fill="white" stroke="#EB001B" stroke-width="0.7">
                            </svg>
                          </div>
                        </quantity-popover>
                      </div>

                      <cart-remove-button
                        id="CartDrawer-Remove-{{ item.index | plus: 1 }}"
                        class="dizzy-cart-drawer__remove-wrap"
                        data-index="{{ item.index | plus: 1 }}"
                      >
                        <button
                          type="button"
                          class="cart-remove-button dizzy-cart-drawer__remove"
                          data-cart-mutation-control
                          aria-label="{{ 'sections.cart.remove_title' | t: title: item.title }}"
                          data-variant-id="{{ item.variant.id }}"
                        >
                          {% render 'icon-remove' %}
                        </button>
                      </cart-remove-button>
                    </li>
                  {%- endfor -%}
                </ul>
              </div>

              <p id="CartDrawer-LiveRegionText" class="visually-hidden" role="status"></p>
              <p id="CartDrawer-LineItemStatus" class="visually-hidden" aria-hidden="true" role="status">
                {{ 'accessibility.loading' | t }}
              </p>
            </div>
            <div id="CartDrawer-CartErrors" role="alert"></div>
          </form>
        </cart-drawer-items>

        <div class="drawer__footer cart-drawer__footer dizzy-cart-drawer__footer">
          <div class="dizzy-cart-drawer__discount">
            <form class="dizzy-cart-drawer__discount-form" data-cart-discount-form>
              <label class="visually-hidden" for="CartDrawer-DiscountCode">Discount code</label>
              <div class="dizzy-cart-drawer__discount-field">
                {%- render 'icon-tag-discount', class: 'icon dizzy-cart-drawer__discount-svg' -%}
                <input
                  id="CartDrawer-DiscountCode"
                  class="dizzy-cart-drawer__discount-input"
                  type="text"
                  name="discount"
                  placeholder="Discount code"
                  autocomplete="off"
                  data-cart-mutation-control
                >
              </div>
              <button class="dizzy-cart-drawer__discount-button" type="submit" data-cart-mutation-control>Apply</button>
              <p class="dizzy-cart-drawer__discount-message" data-cart-discount-message role="status"></p>
            </form>
            {%- if cart.cart_level_discount_applications.size > 0 -%}
              <ul class="discounts list-unstyled dizzy-cart-drawer__applied-discounts" role="list" aria-label="{{ 'customer.order.discount' | t }}">
                {%- for discount in cart.cart_level_discount_applications -%}
                  <li class="discounts__discount discounts__discount--end">
                    {%- render 'icon-discount' -%}
                    {{ discount.title }}
                    (-{{ discount.total_allocated_amount | money }})
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>

          <div class="dizzy-cart-drawer__subtotal">
            <div class="totals dizzy-cart-drawer__totals" role="status">
              <h2 class="totals__total">Subtotal</h2>
              <p class="totals__total-value">{{ cart.total_price | money }}</p>
            </div>
            <small class="tax-note caption-large rte">Shipping &amp; taxes calculated at checkout.</small>
          </div>

          <div class="cart__ctas dizzy-cart-drawer__ctas">
            <noscript>
              <button type="submit" class="cart__update-button button button--secondary" form="CartDrawer-Form">
                {{ 'sections.cart.update' | t }}
              </button>
            </noscript>

            <button
              type="submit"
              id="CartDrawer-Checkout"
              class="cart__checkout-button button dizzy-cart-drawer__button dizzy-cart-drawer__button--primary"
              name="checkout"
              form="CartDrawer-Form"
              data-cart-mutation-control
            >
              Checkout
            </button>
            <a href="{{ routes.all_products_collection_url }}" class="dizzy-cart-drawer__continue">
              {{ 'general.continue_shopping' | t }}
            </a>
          </div>

          {%- if shop.enabled_payment_types.size > 0 -%}
            <div class="dizzy-cart-drawer__payment">
              <p class="dizzy-cart-drawer__payment-title">We accept</p>
              <ul class="list list-payment" role="list">
                {%- for type in shop.enabled_payment_types -%}
                  <li class="list-payment__item">
                    {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                  </li>
                {%- endfor -%}
              </ul>
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</cart-drawer>
